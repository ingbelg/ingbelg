{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    },
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "ingbelg.vercel.app" }],
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    },
    {
      "source": "/_astro/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ],
  "redirects": [
    { "source": "/privacy-policy", "destination": "/privacybeleid", "permanent": true },
    { "source": "/privacy-policy/", "destination": "/privacybeleid", "permanent": true },
    { "source": "/offerte-aanvragen", "destination": "/#contact", "permanent": true },
    { "source": "/offerte-aanvragen/", "destination": "/#contact", "permanent": true },
    { "source": "/algemene-bouwwerken-ingbelg", "destination": "/#diensten", "permanent": true },
    { "source": "/algemene-bouwwerken-ingbelg/", "destination": "/#diensten", "permanent": true },
    { "source": "/contact", "destination": "/#contact", "permanent": true },
    { "source": "/contact/", "destination": "/#contact", "permanent": true },
    { "source": "/realisaties", "destination": "/#realisaties", "permanent": true },
    { "source": "/realisaties/", "destination": "/#realisaties", "permanent": true },
    { "source": "/over-ons", "destination": "/#over", "permanent": true },
    { "source": "/over-ons/", "destination": "/#over", "permanent": true },
    { "source": "/diensten", "destination": "/#diensten", "permanent": true },
    { "source": "/diensten/", "destination": "/#diensten", "permanent": true }
  ]
}

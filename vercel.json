{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "ingbelg.vercel.app"
        }
      ],
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/_astro/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "redirects": [
    { "source": "/privacy-policy", "destination": "/privacybeleid", "permanent": true },
    { "source": "/privacy-policy/", "destination": "/privacybeleid", "permanent": true },
    { "source": "/offerte-aanvragen", "destination": "/#contact", "permanent": true },
    { "source": "/offerte-aanvragen/", "destination": "/#contact", "permanent": true },
    { "source": "/algemene-bouwwerken-ingbelg", "destination": "/#diensten", "permanent": true },
    { "source": "/algemene-bouwwerken-ingbelg/", "destination": "/#diensten", "permanent": true },
    { "source": "/author/admin", "destination": "/", "permanent": true },
    { "source": "/author/admin/", "destination": "/", "permanent": true },
    { "source": "/sample-page", "destination": "/", "permanent": true },
    { "source": "/sample-page/", "destination": "/", "permanent": true }
  ]
}

---
import LandingPage from '../components/LandingPage.astro';
import type { LandingData } from '../components/LandingPage.astro';
import { faqKost, faqGratis, faqPremie, steps } from '../data/landing-shared';

export const prerender = true;

/* Alle regels komen van FOD Financiën, geraadpleegd op 4 oktober 2026:
   - fin.belgium.be/nl/particulieren/woning/bouwen-verbouwen/verbouwen/verbouwen-btw-tarief
     (ouder dan 10 jaar: datum eerste ingebruikneming telt voor een volledig jaar + datum eerste factuur; voorbeeld 2012 → voorschotfactuur
      5/11/2022 = ok; > 50 % privé; voorbeeld 30 % beroep + volledig dak = 6 % op het geheel, enkel muren beroepsruimte = 21 %;
      verstrekt en gefactureerd aan de gebruiker; materialen via aannemer 6 %, zelf gekocht 21 %; omvorming/renovatie/verbetering/herstelling/
      onderhoud, niet reiniging; afbraak die niet voorafgaat aan renovatie 21 %; architect/studiewerk 21 %; vermelding op de factuur sinds
      1/7/2022, 1 maand om schriftelijk te betwisten; voorwaarde niet voldaan → 21 % en de klant is aansprakelijk; bijgebouwde oppervlakte
      niet groter dan het behouden deel, behouden dragende structuur ≥ 50 % in lopende meters)
   - Lijst "Btw-tarief van toepassing op bepaalde soorten werken" (fin.belgium.be, pdf): "isolatie van de woning" → 6 %.
   Bewust NIET opgenomen: afbraak en heropbouw (eigen regels, enkel een verwijzing), het verlaagd tarief voor nieuwbouw/sociale
   woningen, zonnepanelen (niet nagekeken). Bij nieuwe regels: deze pagina nalezen, ook faqBtw in landing-shared.ts en de FAQ op de startpagina. */
const page: LandingData = {
  slug: 'btw-dakwerken',

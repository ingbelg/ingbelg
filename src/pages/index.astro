---
import Layout from '../layouts/Layout.astro';
import Topbar from '../components/site/Topbar.astro';
import SiteHeader from '../components/site/SiteHeader.astro';
import SiteFooter from '../components/site/SiteFooter.astro';
import ContactSection from '../components/site/ContactSection.astro';
import Hero from '../components/home/Hero.astro';
import TrustStrip from '../components/home/TrustStrip.astro';
import Problems from '../components/home/Problems.astro';
import Services from '../components/home/Services.astro';
import TemporaryRoof from '../components/home/TemporaryRoof.astro';
import Gallery from '../components/home/Gallery.astro';
import Reviews from '../components/home/Reviews.astro';
import Promises from '../components/home/Promises.astro';
import Calculator from '../components/home/Calculator.astro';
import CtaBand from '../components/home/CtaBand.astro';
import About from '../components/home/About.astro';
import ServiceArea from '../components/home/ServiceArea.astro';
import Faq from '../components/home/Faq.astro';
import { FOOTER_SERVICES_HOME, FOOTER_NAV_HOME } from '../data/navigation';
import facts from '../data/site-facts.json';

export const prerender = true;

---
<Layout>

<a class="skip-link" href="#main">Ga naar inhoud</a>

{/* ============ TOPBAR (C-01) ============ */}
<Topbar />

{/* ============ HEADER ============ */}
<SiteHeader brandHref="#top" brandLabel="INGBELG home" burger>
  <nav class="nav" id="nav" aria-label="Hoofdnavigatie">
        <ul>
          <li><a href="#diensten">Diensten</a></li>
          <li><a href="#realisaties">Realisaties</a></li>
          <li><a href="#reviews">Reviews</a></li>
          <li><a href="#voordelen">Onze afspraken</a></li>
          <li><a href="#calculator">Premies &amp; btw</a></li>
          <li><a href="#over">Over ons</a></li>
          <li><a href="#faq">FAQ</a></li>
        </ul>
        <div class="nav__mobilecta">
          <a class="btn btn--primary btn--block" href="#contact"><span>Gratis plaatsbezoek</span></a>
          <a class="btn btn--ghost btn--block" href={`tel:${facts.phoneE164}`}><span>{facts.phone}</span></a>
        </div>
      </nav>
</SiteHeader>

<main id="main">
{/* ============ HERO ============ */}
<Hero />

{/* ============ TRUST STRIP (C-09) ============ */}
<TrustStrip />

{/* ============ HERKENT U DIT? (C-10, vervangt USP) ============ */}
<Problems />

{/* ============ DIENSTEN ============ */}
<Services />

{/* ============ TIJDELIJK DAK ============ */}
<TemporaryRoof />

{/* ============ REALISATIES ============ */}
<Gallery />

{/* ============ REVIEWS (C-20, verplaatst na Realisaties) ============ */}
<Reviews />

{/* ============ VIJF AFSPRAKEN (C-21, vervangt Werkwijze + Waarom) ============ */}
<Promises />

{/* ============ PREMIE-CALCULATOR ============ */}
<Calculator />

{/* ============ CTA BAND (C-23) ============ */}
<CtaBand />

{/* ============ OVER ONS (C-24, verplaatst na de calculator) ============ */}
<About />

{/* ============ WAAR WE WERKEN (C-25, nieuw) ============ */}
<ServiceArea />

{/* ============ FAQ (C-26) ============ */}
<Faq />

{/* ============ CONTACT ============ */}
<ContactSection />

</main>

{/* ============ FOOTER (C-30) ============ */}
<SiteFooter services={FOOTER_SERVICES_HOME} navigation={FOOTER_NAV_HOME} trust />

{/* Sticky mobile action bar (C-31) */}
<div class="mobilebar">
  <a href={`tel:${facts.phoneE164}`}><svg viewBox="0 0 24 24"><path d="M6.6 10.8a15.1 15.1 0 0 0 6.6 6.6l2.2-2.2a1 1 0 0 1 1-.25c1.1.37 2.3.57 3.6.57a1 1 0 0 1 1 1V20a1 1 0 0 1-1 1A17 17 0 0 1 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1c0 1.3.2 2.5.57 3.6a1 1 0 0 1-.25 1z"/></svg>Bellen</a>
  <a href={`https://wa.me/${facts.phoneE164.replace('+', '')}`} target="_blank" rel="noopener"><svg viewBox="0 0 24 24"><path d="M12 2a10 10 0 0 0-8.6 15L2 22l5.2-1.4A10 10 0 1 0 12 2m5.1 14.1c-.2.6-1.2 1.2-1.7 1.2s-1.1.2-3.6-.8-4-3.5-4.2-3.7-1.2-1.6-1.2-3 .8-2.1 1-2.4.6-.3.8-.3h.6c.2 0 .4 0 .7.5s.9 2.1 1 2.3.1.3 0 .5-.2.5-.4.7-.4.4-.2.7 1 1.5 2 2.4a8 8 0 0 0 2.1 1.2c.3.2.5.1.7-.1l.9-1.1c.2-.3.4-.2.7-.1l2 1c.3.1.5.2.6.3s.1.7-.1 1.3"/></svg>WhatsApp</a>
  <a class="mobilebar__cta" href="#contact">Plaatsbezoek</a>
</div>

{/* Lightbox */}
<div class="lb" id="lightbox" aria-hidden="true">
  <button class="lb__close" id="lbClose" aria-label="Sluiten">&times;</button>
  <button class="lb__nav lb__nav--prev" id="lbPrev" aria-label="Vorige">&#8249;</button>
  <img class="lb__img" id="lbImg" alt="">
  <button class="lb__nav lb__nav--next" id="lbNext" aria-label="Volgende">&#8250;</button>
  <div class="lb__counter" id="lbCount"></div>
</div>

</Layout>

---
import Layout from '../layouts/Layout.astro';
import GoogleReviews from '../components/GoogleReviews.astro';
import { getCollection } from 'astro:content';

export const prerender = true;

const services = (await getCollection('services')).sort((a, b) => a.data.num.localeCompare(b.data.num));
const gallery = (await getCollection('gallery')).sort((a, b) => a.data.order - b.data.order);

const sizeClass: Record<string, string> = { tall: ' gal--tall', wide: ' gal--wide', normal: '' };
---
<Layout>

<a class="skip-link" href="#diensten">Ga naar inhoud</a>

<!-- ============ TOPBAR ============ -->
<div class="topbar">
  <div class="container topbar__in">
    <div class="topbar__left">
      <a class="topbar__item" href="tel:+32488876061">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6.6 10.8a15.1 15.1 0 0 0 6.6 6.6l2.2-2.2a1 1 0 0 1 1-.25c1.1.37 2.3.57 3.6.57a1 1 0 0 1 1 1V20a1 1 0 0 1-1 1A17 17 0 0 1 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1c0 1.3.2 2.5.57 3.6a1 1 0 0 1-.25 1z"/></svg>
        <span>+32 488 87 60 61</span>
      </a>
      <a class="topbar__item" href="mailto:info@ingbelg.be">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20 4H4a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V6a2 2 0 0 0-2-2m0 4-8 5-8-5V6l8 5 8-5z"/></svg>
        <span>info@ingbelg.be</span>
      </a>
      <span class="topbar__item topbar__item--muted">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2a7 7 0 0 0-7 7c0 5.25 7 13 7 13s7-7.75 7-13a7 7 0 0 0-7-7m0 9.5A2.5 2.5 0 1 1 14.5 9 2.5 2.5 0 0 1 12 11.5"/></svg>
        <span>Hoogstraat 59, 9620 Zottegem</span>
      </span>
    </div>
    <div class="topbar__right">
      <span class="topbar__badge">BTW BE 0721.841.831</span>
      <a class="topbar__wa" href="https://wa.me/32488876061" target="_blank" rel="noopener">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2a10 10 0 0 0-8.6 15L2 22l5.2-1.4A10 10 0 1 0 12 2m5.1 14.1c-.2.6-1.2 1.2-1.7 1.2s-1.1.2-3.6-.8-4-3.5-4.2-3.7-1.2-1.6-1.2-3 .8-2.1 1-2.4.6-.3.8-.3h.6c.2 0 .4 0 .7.5s.9 2.1 1 2.3.1.3 0 .5-.2.5-.4.7-.4.4-.2.7 1 1.5 2 2.4a8 8 0 0 0 2.1 1.2c.3.2.5.1.7-.1l.9-1.1c.2-.3.4-.2.7-.1l2 1c.3.1.5.2.6.3s.1.7-.1 1.3"/></svg>
        WhatsApp
      </a>
    </div>
  </div>
</div>

<!-- ============ HEADER ============ -->
<header class="header" id="header">
  <div class="container header__in">
    <a class="brand" href="#top" aria-label="INGBELG home">
      <img src="/assets/logo.png" alt="INGBELG — algemene dakwerken en renovatie">
    </a>

    <nav class="nav" id="nav" aria-label="Hoofdnavigatie">
      <ul>
        <li><a href="#top" class="is-active">Home</a></li>
        <li><a href="#over">Over ons</a></li>
        <li><a href="#diensten">Diensten</a></li>
        <li><a href="#realisaties">Realisaties</a></li>
        <li><a href="#voordelen">Waarom INGBELG</a></li>
        <li><a href="#calculator">Premie-check</a></li>
        <li><a href="#faq">FAQ</a></li>
        <li><a href="#contact">Contact</a></li>
      </ul>
      <div class="nav__mobilecta">
        <a class="btn btn--primary btn--block" href="#contact">Offerte aanvragen</a>
        <a class="btn btn--ghost btn--block" href="tel:+32488876061">+32 488 87 60 61</a>
      </div>
    </nav>

    <div class="header__actions">
      <a class="btn btn--primary" href="#contact">
        <span>Offerte aanvragen</span>
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h13M13 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </a>
      <button class="burger" id="burger" aria-label="Menu openen" aria-expanded="false" aria-controls="nav">
        <span></span><span></span><span></span>
      </button>
    </div>
  </div>
</header>

<!-- ============ HERO ============ -->
<section class="hero" id="top">
  <div class="hero__media">
    <video class="hero__video" autoplay muted loop playsinline preload="auto" poster="/assets/services/hellende-daken.jpg">
      <source src="/assets/hero.mp4" type="video/mp4">
    </video>
    <div class="hero__scrim"></div>
    <div class="hero__grain"></div>
  </div>

  <div class="container hero__in">
    <p class="hero__eyebrow reveal"><span class="hero__dot"></span>14+ jaar ervaring &middot; Zottegem &middot; Heel Vlaanderen</p>
    <h1 class="hero__title reveal">
      Uw specialist op het gebied van<br>
      <em>dakwerken</em> en algemene renovatie.
    </h1>
    <p class="hero__motto reveal">&ldquo;Uw dak, onze zorg &middot; kwaliteit van boven tot onder&rdquo;</p>
    <p class="hero__lead reveal">
      INGBELG is uw garantie voor professioneel uitgevoerde werken met hoogwaardige
      materialen, klantgerichte service en perfecte resultaten. Kwaliteit in werk,
      materiaal én service.
    </p>
    <div class="hero__cta reveal">
      <a class="btn btn--primary btn--lg" href="#contact">
        <span>Gratis offerte aanvragen</span>
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h13M13 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </a>
      <a class="btn btn--glass btn--lg" href="#realisaties">Bekijk onze realisaties</a>
      <a class="btn btn--glass btn--lg" href="tel:+32488876061">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6.6 10.8a15.1 15.1 0 0 0 6.6 6.6l2.2-2.2a1 1 0 0 1 1-.25c1.1.37 2.3.57 3.6.57a1 1 0 0 1 1 1V20a1 1 0 0 1-1 1A17 17 0 0 1 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1c0 1.3.2 2.5.57 3.6a1 1 0 0 1-.25 1z"/></svg>
        <span>Bel nu</span>
      </a>
    </div>

    <div class="hero__trust reveal">
      <script is:inline defer async src="https://cdn.trustindex.io/loader.js?b923111780c9269d65468aace3c"></script>
    </div>

    <ul class="hero__stats reveal">
      <li><strong data-count="48" data-suffix="u">0</strong><span>Offerte binnen</span></li>
      <li><strong data-count="14" data-suffix="+">0</strong><span>Jaar ervaring</span></li>
      <li><strong data-count="500" data-suffix="+">0</strong><span>Daken gerealiseerd</span></li>
      <li><strong data-count="15" data-suffix=" jaar">0</strong><span>Garantie op werken</span></li>
    </ul>
  </div>

  <a class="hero__scroll" href="#usp" aria-label="Scroll naar beneden">
    <span class="hero__scroll-line"></span>
    <span class="hero__scroll-txt">Scroll</span>
  </a>
</section>

<!-- ============ USP STRIP ============ -->
<section class="usp" id="usp">
  <div class="container usp__grid">
    <article class="usp__card reveal">
      <div class="usp__icon">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2 3 6v6c0 5 3.8 9.4 9 10 5.2-.6 9-5 9-10V6zm-1 14-4-4 1.4-1.4L11 13.2l4.6-4.6L17 10z"/></svg>
      </div>
      <h3>Veilig en voordelig</h3>
      <p>Hellende daken in dakpannen of leien, platte daken met hoogwaardige EPDM — altijd volgens de regels van de kunst en met de juiste veiligheidsvoorzieningen.</p>
    </article>
    <article class="usp__card reveal">
      <div class="usp__icon">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 1 3 5v6c0 5.5 3.8 10.7 9 12 5.2-1.3 9-6.5 9-12V5zm0 4.5 1.9 3.9 4.3.6-3.1 3 .7 4.3-3.8-2-3.8 2 .7-4.3-3.1-3 4.3-.6z"/></svg>
      </div>
      <h3>Zorgvuldigheid</h3>
      <p>Wij voeren de werkzaamheden uit met respect voor uw wensen, uw budget en de afgesproken planning. Een propere werf is voor ons vanzelfsprekend.</p>
    </article>
    <article class="usp__card reveal">
      <div class="usp__icon">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8zm-1 7V3.5L18.5 9zM8 13h8v2H8zm0 4h8v2H8z"/></svg>
      </div>
      <h3>Gratis offerte</h3>
      <p>Van ontwerp tot oplevering. U ontvangt een heldere, vrijblijvende prijsofferte binnen de 48 uur — zonder verplichtingen en zonder verrassingen achteraf.</p>
    </article>
  </div>
</section>

<!-- ============ OVER ONS ============ -->
<section class="about section" id="over">
  <div class="container about__grid">
    <div class="about__media reveal">
      <div class="about__img about__img--main">
        <img src="/assets/work/work-05.jpg" alt="Dakwerken door INGBELG" loading="lazy">
      </div>
      <div class="about__img about__img--sub">
        <img src="/assets/services/platte-daken.jpg" alt="Plat dak met EPDM" loading="lazy">
      </div>
      <div class="about__badge">
        <strong>15</strong>
        <span>jaar<br>garantie</span>
      </div>
    </div>

    <div class="about__body reveal">
      <p class="eyebrow"><span class="eyebrow__bar"></span>Over INGBELG</p>
      <h2 class="h2">Kwaliteit in werk,<br>materiaal <em>én</em> service.</h2>
      <p class="lead">
        INGBELG — Algemene dak- en renovatiewerken — is gevestigd in Zottegem en actief in
        heel Vlaanderen. Wij verzorgen totaalrenovaties met een persoonlijke aanpak:
        één aanspreekpunt van het eerste plaatsbezoek tot de definitieve oplevering.
      </p>
      <p>
        Of het nu gaat om een plat dak in EPDM, een hellend dak in pannen of leien,
        een nieuwe dakconstructie, gevelbekleding, zonnepanelen of ecopanelen — wij
        werken uitsluitend met hoogwaardige materialen en vakmensen uit eigen team.
      </p>

      <ul class="ticks">
        <li>Vast aanspreekpunt gedurende het volledige project</li>
        <li>Eigen, ervaren dakdekkers — geen onderaanneming</li>
        <li>Duidelijke prijsafspraken en strikte planning</li>
        <li>Advies over premies en subsidies inbegrepen</li>
      </ul>

      <div class="about__cta">
        <a class="btn btn--primary" href="#contact"><span>Plan een gratis plaatsbezoek</span></a>
        <a class="btn btn--line" href="tel:+32488876061">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6.6 10.8a15.1 15.1 0 0 0 6.6 6.6l2.2-2.2a1 1 0 0 1 1-.25c1.1.37 2.3.57 3.6.57a1 1 0 0 1 1 1V20a1 1 0 0 1-1 1A17 17 0 0 1 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1c0 1.3.2 2.5.57 3.6a1 1 0 0 1-.25 1z"/></svg>
          <span>+32 488 87 60 61</span>
        </a>
      </div>
    </div>
  </div>
</section>

<!-- ============ MERKEN / MATERIALEN ============ -->
<section class="brands">
  <div class="container">
    <p class="brands__label">Wij werken met kwaliteitsmaterialen &amp; A-merken</p>
    <ul class="brands__row">
      <li>EPDM</li>
      <li>Firestone</li>
      <li>Resistrix</li>
      <li>Trespa</li>
      <li>Rockpanel</li>
      <li>PIR-isolatie</li>
    </ul>
  </div>
</section>

<!-- ============ DIENSTEN ============ -->
<section class="section section--soft" id="diensten">
  <div class="container">
    <header class="sechead reveal">
      <p class="eyebrow"><span class="eyebrow__bar"></span>Onze diensten</p>
      <h2 class="h2">Alles voor uw dak <em>en</em> uw gevel</h2>
      <p class="sechead__sub">Zeven specialisaties onder één dak. U hoeft maar één aannemer te bellen.</p>
    </header>

    <div class="services">
      {services.map((s) => (
        <article class="svc reveal">
          <div class="svc__img"><img src={s.data.image} alt={s.data.title} loading="lazy" /></div>
          <div class="svc__body">
            <span class="svc__num">{s.data.num}</span>
            <h3>{s.data.title}</h3>
            <p>{s.data.description}</p>
            <ul class="svc__tags">
              {s.data.tags.map((tag) => <li>{tag}</li>)}
            </ul>
            <a class="svc__link" href="#contact">Offerte aanvragen
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h13M13 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </a>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<!-- ============ REALISATIES ============ -->
<section class="section" id="realisaties">
  <div class="container">
    <header class="sechead sechead--row reveal">
      <div>
        <p class="eyebrow"><span class="eyebrow__bar"></span>Realisaties</p>
        <h2 class="h2">Werk dat voor <em>zichzelf</em> spreekt</h2>
      </div>
      <p class="sechead__sub">Een selectie uit onze recent opgeleverde daken, gevels en renovaties in heel Vlaanderen.</p>
    </header>
  </div>

  <div class="container">
    <div class="ba reveal">
      <div class="ba__slider" id="baSlider">
        <div class="ba__img ba__img--before"><img src="/assets/work/work-06.jpg" alt="Dak voor renovatie — demo" loading="lazy"></div>
        <div class="ba__img ba__img--after"><img src="/assets/work/work-05.jpg" alt="Dak na renovatie — demo" loading="lazy"></div>
        <input class="ba__range" id="baRange" type="range" min="0" max="100" value="50" aria-label="Sleep om voor en na te vergelijken">
        <div class="ba__handle" aria-hidden="true"></div>
        <span class="ba__tag ba__tag--before">Voor</span>
        <span class="ba__tag ba__tag--after">Na</span>
      </div>
      <p class="ba__note">Demo-weergave met bestaande projectfoto&rsquo;s — wordt vervangen door een echte voor/na-set van hetzelfde dak.</p>
    </div>

    <div class="gallery" id="gallery">
      {gallery.map((g) => (
        <figure class={`gal reveal${sizeClass[g.data.size]}`}>
          <img src={g.data.image} alt={g.data.alt} loading="lazy" />
          <figcaption><span>{g.data.label}</span><em>{g.data.caption}</em></figcaption>
        </figure>
      ))}
    </div>
  </div>
</section>

<!-- ============ WERKWIJZE ============ -->
<section class="section section--soft">
  <div class="container">
    <header class="sechead sechead--center reveal">
      <p class="eyebrow eyebrow--center"><span class="eyebrow__bar"></span>Werkwijze</p>
      <h2 class="h2">In vijf stappen naar uw <em>nieuwe dak</em></h2>
    </header>

    <ol class="steps">
      <li class="steps__item reveal">
        <span class="steps__num">01</span>
        <h3>Gratis plaatsbezoek</h3>
        <p>Wij komen ter plaatse, bekijken uw dak en luisteren naar uw wensen en budget.</p>
      </li>
      <li class="steps__item reveal">
        <span class="steps__num">02</span>
        <h3>Offerte binnen 48u</h3>
        <p>U ontvangt een heldere, vrijblijvende prijsofferte rechtstreeks in uw mailbox.</p>
      </li>
      <li class="steps__item reveal">
        <span class="steps__num">03</span>
        <h3>Planning &amp; akkoord</h3>
        <p>Na uw akkoord leggen we een concrete startdatum en planning schriftelijk vast.</p>
      </li>
      <li class="steps__item reveal">
        <span class="steps__num">04</span>
        <h3>Uitvoering</h3>
        <p>Ons eigen team voert de werken uit — met valbeveiliging en dagelijkse opruim.</p>
      </li>
      <li class="steps__item reveal">
        <span class="steps__num">05</span>
        <h3>Oplevering &amp; garantie</h3>
        <p>U krijgt een schriftelijke garantie van 15 jaar en wij blijven nadien bereikbaar.</p>
      </li>
    </ol>
  </div>
</section>

<!-- ============ VOORDELEN ============ -->
<section class="section adv" id="voordelen">
  <div class="container">
    <header class="sechead sechead--center reveal">
      <p class="eyebrow eyebrow--center"><span class="eyebrow__bar"></span>Waarom INGBELG</p>
      <h2 class="h2">Acht redenen om met ons <em>in zee</em> te gaan</h2>
    </header>

    <div class="adv__grid">
      <article class="adv__card reveal">
        <div class="adv__ico"><svg viewBox="0 0 24 24"><path d="M12 2 3 6v6c0 5 3.8 9.4 9 10 5.2-.6 9-5 9-10V6zm-1 14-4-4 1.4-1.4L11 13.2l4.6-4.6L17 10z"/></svg></div>
        <h3>15 jaar garantie</h3>
        <p>Op alle uitgevoerde dakwerken en materialen krijgt u een schriftelijke garantie. Wij staan achter ons werk, ook jaren na de oplevering.</p>
      </article>
      <article class="adv__card reveal">
        <div class="adv__ico"><svg viewBox="0 0 24 24"><path d="M12 2a10 10 0 1 0 10 10A10 10 0 0 0 12 2m1 10.6V6h-2v7.4l5.2 3.1 1-1.7z"/></svg></div>
        <h3>Offerte binnen 48 uur</h3>
        <p>Na het plaatsbezoek ontvangt u binnen twee werkdagen een gedetailleerde, vrijblijvende offerte in uw mailbox.</p>
      </article>
      <article class="adv__card reveal">
        <div class="adv__ico"><svg viewBox="0 0 24 24"><path d="M16 11a4 4 0 1 0-4-4 4 4 0 0 0 4 4m-8 0a4 4 0 1 0-4-4 4 4 0 0 0 4 4m0 2c-3 0-8 1.5-8 4.5V21h10v-3.5A4.4 4.4 0 0 1 11 14a13 13 0 0 0-3-1m8 0a11 11 0 0 0-2 .2A5.3 5.3 0 0 1 16 17.5V21h8v-3.5c0-3-5-4.5-8-4.5"/></svg></div>
        <h3>Eigen vast team</h3>
        <p>Geen wisselende onderaannemers. Uw werf wordt uitgevoerd door onze eigen, ervaren dakdekkers en timmerlieden.</p>
      </article>
      <article class="adv__card reveal">
        <div class="adv__ico"><svg viewBox="0 0 24 24"><path d="M11.8 2 2 12h3v8h6v-6h2v6h6v-8h3zM7 22h10v-2H7z"/></svg></div>
        <h3>Totaaloplossing</h3>
        <p>Dak, isolatie, gevel, goten, zonnepanelen en ecopanelen — alles bij dezelfde partner, met één planning en één factuur.</p>
      </article>
      <article class="adv__card reveal">
        <div class="adv__ico"><svg viewBox="0 0 24 24"><path d="M12 1 3 5v6c0 5.5 3.8 10.7 9 12 5.2-1.3 9-6.5 9-12V5zm0 4.5 1.9 3.9 4.3.6-3.1 3 .7 4.3-3.8-2-3.8 2 .7-4.3-3.1-3 4.3-.6z"/></svg></div>
        <h3>Premiebegeleiding</h3>
        <p>Wij volgen de Fluvius-premies, de totaalrenovatiebonus en de Vlaamse renovatiepremie op en helpen u bij de aanvraag.</p>
      </article>
      <article class="adv__card reveal">
        <div class="adv__ico"><svg viewBox="0 0 24 24"><path d="M20 6h-3V4a2 2 0 0 0-2-2H9a2 2 0 0 0-2 2v2H4a2 2 0 0 0-2 2v11a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V8a2 2 0 0 0-2-2M9 4h6v2H9zm4 12h-2v2h-2v-2H7v-2h2v-2h2v2h2z"/></svg></div>
        <h3>Propere werf</h3>
        <p>Containers, valbeveiliging en dagelijkse opruim horen standaard bij de prijs. Uw tuin en oprit blijven intact.</p>
      </article>
      <article class="adv__card reveal">
        <div class="adv__ico"><svg viewBox="0 0 24 24"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8zm-1 7V3.5L18.5 9zM8 13h8v2H8zm0 4h8v2H8z"/></svg></div>
        <h3>WTCB-richtlijnen</h3>
        <p>Al onze werken worden uitgevoerd volgens de technische voorschriften van het WTCB — de Belgische bouwreferentie.</p>
      </article>
      <article class="adv__card reveal">
        <div class="adv__ico"><svg viewBox="0 0 24 24"><path d="M12 2 3 6v6c0 5 3.8 9.4 9 10 5.2-.6 9-5 9-10V6zm-1 14-4-4 1.4-1.4L11 13.2l4.6-4.6L17 10z"/></svg></div>
        <h3>Verzekerd &amp; attest</h3>
        <p>Wij werken verzekerd en bezorgen u het nodige attest, ook bij asbestverwijdering vóór de dakwerken.</p>
      </article>
    </div>
  </div>
</section>

<!-- ============ PREMIE-CALCULATOR ============ -->
<section class="section calc-sec" id="calculator">
  <div class="container">
    <header class="sechead sechead--center reveal">
      <p class="eyebrow eyebrow--center"><span class="eyebrow__bar"></span>Exclusief bij INGBELG</p>
      <h2 class="h2">Bereken uw <em>premies &amp; subsidies</em></h2>
      <p class="sechead__sub">Geen enkele andere dakwerker in de regio biedt dit. Vul uw gegevens in en ontvang meteen een indicatie van de premies waarop u mogelijk recht hebt.</p>
    </header>

    <div class="calc reveal">
      <form class="calc__form" id="calcForm" novalidate>
        <div class="calc__row">
          <label class="field">
            <span>Type dak</span>
            <select name="type" id="calcType">
              <option value="hellend">Hellend dak</option>
              <option value="plat">Plat dak</option>
            </select>
          </label>
          <label class="field">
            <span>Dakoppervlakte (m²)</span>
            <input type="number" name="m2" id="calcM2" min="1" max="500" step="1" value="100">
          </label>
        </div>

        <label class="field">

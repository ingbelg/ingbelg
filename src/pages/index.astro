---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import facts from '../data/site-facts.json';

export const prerender = true;

const services = (await getCollection('services')).sort((a, b) => a.data.num.localeCompare(b.data.num));
const gallery = (await getCollection('gallery')).sort((a, b) => a.data.order - b.data.order);

const sizeClass: Record<string, string> = { tall: ' gal--tall', wide: ' gal--wide', normal: '' };

const faqItems = [
  {
    q: 'Wat kost een nieuw dak?',
    a: 'Dat hangt af van de oppervlakte, het type dak en wat er onder de pannen zit. Daarom geven we geen prijs aan de telefoon, wel een offerte binnen 48 uur na het plaatsbezoek, per post uitgeschreven. Met de premie-check hierboven ziet u vooraf al wat u terugkrijgt.',
  },
  {
    q: 'Zijn de offertes gratis?',
    a: 'Ja. Het plaatsbezoek en de offerte zijn gratis en vrijblijvend. Pas als u de offerte ondertekent, gaan we aan de slag.',
  },
  {
    q: 'Betaal ik 6 % of 21 % btw?',
    a: 'Is uw woning ouder dan 10 jaar en gebruikt u ze vooral als privéwoning? Dan betaalt u 6 % btw op de werken in plaats van 21 %. Wij passen dat correct toe op de factuur. Voor een woning jonger dan 10 jaar geldt 21 %.',
  },
  {
    q: 'Kan ik nog genieten van premies?',
    a: 'Ja, als u in inkomenscategorie 3 of 4 valt. Sinds 1 maart 2026 krijgen de twee hoogste inkomenscategorieën geen dakpremie meer. Voor categorie 4 gaat het om maximaal 50 % van de factuur (tot € 5.750), voor categorie 3 om maximaal 35 % (tot € 4.025). Voorwaarde: het dak wordt tegelijk nieuw geïsoleerd, met een Rd-waarde van minstens 4,5 m²K/W. Soms komen er gemeentelijke premies bij. Tijdens het plaatsbezoek rekenen we het samen na.',
  },
  {
    q: 'Hoe dik wordt de isolatielaag?',
    a: 'Dik genoeg voor de premie-eis: een Rd-waarde van minstens 4,5 m²K/W. Met PIR komt dat neer op ongeveer 10 cm. Meestal adviseren we 12 tot 16 cm, afhankelijk van de dakopbouw en hoe zuinig u wilt wonen.',
  },
  {
    q: 'Moet mijn asbestdak weg?',
    a: 'Niet meteen, zolang het in goede staat is. Maar u mag een asbestdak niet reinigen, ontmossen of er zonnepanelen op plaatsen. Verkoopt u een woning van vóór 2001, dan hebt u een asbestattest nodig. Plant u toch dakwerken, laat het asbest dan meteen mee verwijderen: dat kan in één werf met het nieuwe dak.',
  },
  {
    q: 'Ik kocht een woning met EPC E of F. Wat nu?',
    a: 'Dan moet u de woning binnen zes jaar na de aankoop naar minstens label D brengen. Dakisolatie is daarvoor vaak een logische eerste stap. Breng uw EPC mee naar het plaatsbezoek, dan zeggen we welke dakwerken het meeste opleveren.',
  },
  {
    q: 'Wat als het regent tijdens de werken?',
    a: "Dan blijft uw woning droog. Elk dakvlak dat open ligt, dekken we aan het einde van de werkdag af met ons eigen zeil. Ook als er 's nachts een onverwachte bui valt.",
  },
  {
    q: 'Hoe lang duren de werken?',
    a: 'Een hellend dak van een gemiddelde rijwoning: 5 tot 10 werkdagen. Een plat dak of een gevelbekleding: meestal 2 tot 5 dagen. U krijgt de exacte planning vooraf op papier.',
  },
  {
    q: 'Welke garantie krijg ik?',
    a: `${facts.warrantyYears} jaar schriftelijke garantie op het uitgevoerde werk en de materialen. U krijgt het garantiedocument bij de oplevering.`,
    confirm: 'C-26-10',
  },
  {
    q: 'Heb ik een vergunning nodig?',
    a: 'Voor het vernieuwen van een dak in dezelfde vorm meestal niet. Verandert de vorm, de hoogte of komt er een dakkapel bij, dan vaak wel. Informeer altijd bij uw gemeente; wij bezorgen u de technische gegevens voor de aanvraag.',
  },
  {
    q: 'In welke regio werkt INGBELG?',
    a: 'In Zottegem, de deelgemeenten en de buurgemeenten, en voor grotere projecten in heel Oost- en West-Vlaanderen, Vlaams-Brabant en Antwerpen. Twijfelt u of uw adres binnen ons werkgebied valt? Bel ons gerust.',
  },
];
---
<Layout>

<a class="skip-link" href="#diensten">Ga naar inhoud</a>

<!-- ============ TOPBAR (C-01) ============ -->
<div class="topbar">
  <div class="container topbar__in">
    <div class="topbar__left">
      <a class="topbar__item" href={`tel:${facts.phoneE164}`}>
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6.6 10.8a15.1 15.1 0 0 0 6.6 6.6l2.2-2.2a1 1 0 0 1 1-.25c1.1.37 2.3.57 3.6.57a1 1 0 0 1 1 1V20a1 1 0 0 1-1 1A17 17 0 0 1 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1c0 1.3.2 2.5.57 3.6a1 1 0 0 1-.25 1z"/></svg>
        <span>{facts.phone}</span>
      </a>
      <a class="topbar__item" href={`https://wa.me/${facts.phoneE164.replace('+', '')}`} target="_blank" rel="noopener">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2a10 10 0 0 0-8.6 15L2 22l5.2-1.4A10 10 0 1 0 12 2m5.1 14.1c-.2.6-1.2 1.2-1.7 1.2s-1.1.2-3.6-.8-4-3.5-4.2-3.7-1.2-1.6-1.2-3 .8-2.1 1-2.4.6-.3.8-.3h.6c.2 0 .4 0 .7.5s.9 2.1 1 2.3.1.3 0 .5-.2.5-.4.7-.4.4-.2.7 1 1.5 2 2.4a8 8 0 0 0 2.1 1.2c.3.2.5.1.7-.1l.9-1.1c.2-.3.4-.2.7-.1l2 1c.3.1.5.2.6.3s.1.7-.1 1.3"/></svg>
        <span>WhatsApp</span>
      </a>
      <a class="topbar__item topbar__rating" href={facts.reviews.googleUrl} target="_blank" rel="noopener">
        <span aria-hidden="true">★</span>
        <span>{facts.reviews.score} · {facts.reviews.count} reviews</span>
      </a>
      <span class="topbar__item topbar__item--muted">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2a7 7 0 0 0-7 7c0 5.25 7 13 7 13s7-7.75 7-13a7 7 0 0 0-7-7m0 9.5A2.5 2.5 0 1 1 14.5 9 2.5 2.5 0 0 1 12 11.5"/></svg>
        <span>{facts.address.street}, {facts.address.city}</span>
      </span>
    </div>
    <div class="topbar__right">
      <span class="topbar__badge">BTW {facts.vat}</span>
    </div>
  </div>
</div>

<!-- ============ HEADER ============ -->
<header class="header" id="header">
  <div class="container header__in">
    <a class="brand" href="#top" aria-label="INGBELG home">
      <img src="/assets/logo-transparent.png" alt="INGBELG — algemene dakwerken en renovatie" width="430" height="207">
    </a>

    <nav class="nav" id="nav" aria-label="Hoofdnavigatie">
      <ul>
        <li><a href="#diensten">Diensten</a></li>
        <li><a href="#realisaties">Realisaties</a></li>
        <li><a href="#reviews">Reviews</a></li>
        <li><a href="#voordelen">Onze afspraken</a></li>
        <li><a href="#calculator">Premies &amp; btw</a></li>
        <li><a href="#over">Over ons</a></li>
        <li><a href="#faq">FAQ</a></li>
      </ul>
      <div class="nav__mobilecta">
        <a class="btn btn--primary btn--block" href="#contact"><span>Gratis plaatsbezoek</span></a>
        <a class="btn btn--ghost btn--block" href={`tel:${facts.phoneE164}`}><span>{facts.phone}</span></a>
      </div>
    </nav>

    <div class="header__actions">
      <a class="btn btn--line btn--icon" href={`tel:${facts.phoneE164}`} aria-label={`Bel ${facts.phone}`} title={facts.phone}>
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6.6 10.8a15.1 15.1 0 0 0 6.6 6.6l2.2-2.2a1 1 0 0 1 1-.25c1.1.37 2.3.57 3.6.57a1 1 0 0 1 1 1V20a1 1 0 0 1-1 1A17 17 0 0 1 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1c0 1.3.2 2.5.57 3.6a1 1 0 0 1-.25 1z"/></svg>
      </a>
      <a class="btn btn--primary" href="#contact">
        <span>Gratis plaatsbezoek</span>
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h13M13 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </a>
      <button class="burger" id="burger" aria-label="Menu openen" aria-expanded="false" aria-controls="nav">
        <span></span><span></span><span></span>
      </button>
    </div>
  </div>
</header>

<!-- ============ HERO ============ -->
<section class="hero" id="top">
  <div class="hero__media">
    <!-- T-08: preload="none" + Save-Data-check in main.js (skipVideoOnSaveData) laat op trage verbindingen enkel de poster zien -->
    <video class="hero__video" id="heroVideo" autoplay muted loop playsinline preload="none" poster="/assets/services/hellende-daken.webp">
      <source src="/assets/hero_mobile.mp4" type="video/mp4" media="(max-width: 760px)">
      <source src="/assets/hero.mp4" type="video/mp4">
    </video>
    <div class="hero__scrim"></div>
    <div class="hero__grain"></div>
  </div>

  <div class="container hero__in">
    <p class="hero__eyebrow reveal"><span class="hero__dot"></span>Dakwerker uit Zottegem &middot; eigen ploeg &middot; heel Oost-Vlaanderen</p>
    <h1 class="hero__title reveal">
      <span class="h1-main">Uw dak in één keer goed.</span><br>
      <span class="h1-sub">Dakwerken in Zottegem en heel Oost-Vlaanderen</span>
    </h1>
    <p class="hero__lead reveal">
      Hellende en platte daken, asbestverwijdering, isolatie en gevelbekleding, gelegd
      door onze eigen ploeg. Na het plaatsbezoek hebt u binnen {facts.quoteHoursAfterVisit} uur
      een offerte waarin alles staat. Op het werk krijgt u <!-- ⚠️ CONFIRM C-06: garantieduur --><span data-confirm="C-06">{facts.warrantyYears} jaar garantie</span>, op papier.
    </p>

    <div class="hero__trust reveal">
      <script is:inline defer async src="https://cdn.trustindex.io/loader.js?dc7618f81af7346705466e5f050"></script>
    </div>

    <div class="hero__cta reveal">
      <a class="btn btn--primary btn--lg" href="#contact">
        <span>Vraag een gratis plaatsbezoek</span>
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h13M13 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </a>
      <a class="btn btn--glass btn--lg" href={`https://wa.me/${facts.phoneE164.replace('+', '')}?text=${encodeURIComponent('Hallo INGBELG, hierbij een foto van mijn dak. Mijn gemeente: ')}`} target="_blank" rel="noopener">
        <span>Stuur een foto via WhatsApp →</span>
      </a>
    </div>
    <p class="hero__note reveal">
      Gratis en vrijblijvend &middot; we bellen u binnen {facts.callbackWorkdays} werkdag terug voor een afspraak
    </p>

    <ul class="hero__stats reveal">
      <li><strong class="count" data-count={facts.quoteHoursAfterVisit} data-suffix="u">{facts.quoteHoursAfterVisit}u</strong><span>Offerte na plaatsbezoek</span></li>
      <li><strong class="count" data-count={facts.warrantyYears} data-suffix=" jaar">{facts.warrantyYears} jaar</strong><span>Garantie op papier</span></li>
      <!-- ⚠️ CONFIRM C-08: aantal gerealiseerde daken --><li><strong class="count" data-count={facts.roofsDone} data-suffix="+" data-confirm="C-08">{facts.roofsDone}+</strong><span>Daken gelegd</span></li>
      <li><strong class="count-rating">{facts.reviews.score} ★</strong><span>Uit {facts.reviews.count} reviews</span></li>
    </ul>
  </div>

  <a class="hero__scroll" href="#usp" aria-label="Scroll naar beneden">
    <span class="hero__scroll-line"></span>
    <span class="hero__scroll-txt">Scroll</span>
  </a>
</section>

<!-- ============ TRUST STRIP (C-09) ============ -->
<section class="brands">
  <div class="container">
    <!-- ⚠️ CONFIRM C-09: kopieën van certificaten opvragen bij Magomed vóór livegang (VM Building Solutions, NXTPRO, Trustlocal Top Score) -->
    <p class="brands__label" data-confirm="C-09">Lid van het WTCB &middot; Attest asbest eenvoudige handelingen &middot; Opleiding leien- en pannendaken &middot; Top Score Trustlocal 2025 en 2026</p>
    <ul class="brands__row">
      <li>WTCB</li>
      <li>Asbestattest</li>
      <li>Trustlocal Top Score</li>
    </ul>
    <p class="brands__label" style="margin-top:22px">Wij werken met:</p>
    <ul class="brands__row">
      <li>Firestone EPDM</li>
      <li>Resitrix</li>
      <li>Trespa</li>
      <li>Rockpanel</li>
      <li>PIR-isolatie</li>
    </ul>
  </div>
</section>

<!-- ============ HERKENT U DIT? (C-10, vervangt USP) ============ -->
<section class="section usp" id="usp">
  <div class="container">
    <header class="sechead sechead--center reveal">
      <h2 class="h2">Vijf redenen waarom mensen ons <em>bellen</em></h2>
    </header>
    <div class="adv__grid">
      <!-- ⚠️ CONFIRM C-10: enkel tonen als INGBELG ook herstellingen bij een lek doet -->
      <article class="adv__card reveal" data-confirm="C-10">
        <h3>Er komt water binnen.</h3>
        <p>Een vochtvlek op het plafond of verschoven pannen na een storm. Hoe sneller we kijken, hoe kleiner de schade.</p>
      </article>
      <article class="adv__card reveal">
        <h3>Er ligt nog asbest op het dak.</h3>
        <p>Leien of golfplaten van vóór 2001. We halen ze er veilig af en leggen in dezelfde werf uw nieuwe dak.</p>
      </article>
      <article class="adv__card reveal">
        <h3>De zolder is ijskoud in de winter.</h3>
        <p>Vaak ontbreken isolatie en onderdak. Met 12 tot 16 cm PIR blijft de warmte binnen, en misschien hebt u recht op een premie.</p>
      </article>
      <article class="adv__card reveal">
        <h3>U kocht een woning met EPC E of F.</h3>
        <p>Dan moet u binnen zes jaar naar label D. Een geïsoleerd dak is daarvoor een logische eerste stap.</p>
      </article>
      <article class="adv__card reveal">
        <h3>U wilt zonnepanelen, maar het dak is oud.</h3>
        <p>Eerst het dak, dan de panelen. Zo moet er later niets opnieuw open.</p>
      </article>
    </div>
    <!-- ⚠️ CONFIRM C-10: "ook als uw dak nog jaren meekan" is een eerlijkheidsbelofte — pas publiceren na akkoord Magomed -->
    <p class="sechead sechead--center reveal" style="margin-top:36px" data-confirm="C-10">
      Twijfelt u? <a class="btn btn--line" href={`https://wa.me/${facts.phoneE164.replace('+', '')}?text=${encodeURIComponent('Hallo INGBELG, hierbij een foto van mijn dak. Mijn gemeente: ')}`} target="_blank" rel="noopener"><span>Stuur een foto van uw dak via WhatsApp</span></a><br>
      U krijgt een eerlijk antwoord, ook als uw dak nog jaren meekan.
    </p>
  </div>
</section>

<!-- ============ DIENSTEN ============ -->
<section class="section section--soft" id="diensten">
  <div class="container">
    <header class="sechead reveal">
      <p class="eyebrow"><span class="eyebrow__bar"></span>Onze diensten</p>
      <h2 class="h2">Alles voor uw dak <em>en</em> uw gevel</h2>
      <p class="sechead__sub">Zeven vakgebieden, één eigen ploeg. U belt één aannemer en krijgt één planning en één factuur.</p>
    </header>

    <div class="services">
      {services.map((s) => (
        <article class="svc reveal">
          <div class="svc__img"><img src={s.data.image} alt={s.data.title} width={s.data.imageWidth} height={s.data.imageHeight} loading="lazy" /></div>
          <div class="svc__body">
            <span class="svc__num">{s.data.num}</span>
            <h3>{s.data.title}</h3>
            <p>{s.data.description}</p>
            <ul class="svc__tags">
              {s.data.tags.map((tag) => <li>{tag}</li>)}
            </ul>
            <a class="svc__link" href="#contact" data-service={s.data.title}>Vraag een plaatsbezoek
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h13M13 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </a>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<!-- ============ REALISATIES ============ -->
<section class="section" id="realisaties">
  <div class="container">
    <header class="sechead sechead--row reveal">
      <div>
        <p class="eyebrow"><span class="eyebrow__bar"></span>Realisaties</p>
        <h2 class="h2">Voor en <em>na</em></h2>
      </div>
      <p class="sechead__sub">Echte werven, geen stockfoto's. Schuif over de foto om het verschil te zien.</p>
    </header>
  </div>

  <div class="container">
    <div class="ba-grid reveal">
      <div class="ba">
        <div class="ba__slider">
          <div class="ba__img ba__img--before"><img src="/assets/na_antrociet.webp" alt="Dak na renovatie — antraciet dakpannen" width="1280" height="720" loading="lazy"></div>
          <div class="ba__img ba__img--after"><img src="/assets/voor_antrociet.webp" alt="Dak voor renovatie — antraciet dakpannen" width="1280" height="960" loading="lazy"></div>
          <input class="ba__range" type="range" min="0" max="100" value="50" aria-label="Sleep om voor en na te vergelijken">
          <div class="ba__handle" aria-hidden="true"></div>
          <span class="ba__tag ba__tag--before">Voor</span>
          <span class="ba__tag ba__tag--after">Na</span>
        </div>
        <!-- ⚠️ CONFIRM C-19: gemeente, m² en werkdagen van dit project bevestigen -->
        <p class="ba__label" data-confirm="C-19">Antraciet dakpannen &middot; hellend dak &middot; INGBELG-werf</p>
      </div>
      <div class="ba">
        <div class="ba__slider">
          <div class="ba__img ba__img--before"><img src="/assets/na_rood.webp" alt="Dak na renovatie — rode dakpannen" width="1600" height="1200" loading="lazy" style="object-position:center 15%"></div>
          <div class="ba__img ba__img--after"><img src="/assets/voor_rood.webp" alt="Dak voor renovatie — rode dakpannen" width="1093" height="722" loading="lazy"></div>
          <input class="ba__range" type="range" min="0" max="100" value="50" aria-label="Sleep om voor en na te vergelijken">
          <div class="ba__handle" aria-hidden="true"></div>
          <span class="ba__tag ba__tag--before">Voor</span>
          <span class="ba__tag ba__tag--after">Na</span>
        </div>
        <!-- ⚠️ CONFIRM C-19: gemeente, m² en werkdagen van dit project bevestigen -->
        <p class="ba__label" data-confirm="C-19">Rode dakpannen &middot; hellend dak &middot; INGBELG-werf</p>
      </div>
    </div>

    <div class="gallery" id="gallery">
      {gallery.map((g) => (
        <figure class={`gal reveal${sizeClass[g.data.size]}`}>
          <img src={g.data.image} alt={g.data.alt} width={g.data.imageWidth} height={g.data.imageHeight} loading="lazy" />
        </figure>
      ))}
    </div>

    <p class="sechead sechead--center reveal" style="margin-top:36px">
      <a class="btn btn--line" href={facts.social.instagram} target="_blank" rel="noopener"><span>Meer werven op Instagram →</span></a>
    </p>
  </div>
</section>

<!-- ============ REVIEWS (C-20, verplaatst na Realisaties) ============ -->
<section class="section section--soft" id="reviews">
  <div class="container">
    <header class="sechead sechead--center reveal">
      <p class="eyebrow eyebrow--center"><span class="eyebrow__bar"></span>Wat klanten zeggen</p>
      <h2 class="h2">Wat klanten zeggen <em>na de oplevering</em></h2>
      <p class="sechead__sub">Live overzicht van onze reviews, rechtstreeks van Google.</p>
    </header>

    <p class="sechead sechead--center reveal" style="margin-bottom:36px">
      <a class="btn btn--line" href={facts.reviews.googleUrl} target="_blank" rel="noopener"><span>Alle reviews op Google →</span></a>
    </p>

    <!-- Live Trustindex-widget — klant heeft een betaald abonnement, statische kaarten
         zijn bewust weer verwijderd op zijn verzoek. -->
    <div class="reviews-widget reveal">
      <script is:inline defer async src="https://cdn.trustindex.io/loader.js?1df435b79aed2975f776da650b5"></script>
    </div>
  </div>
</section>

<!-- ============ VIJF AFSPRAKEN (C-21, vervangt Werkwijze + Waarom) ============ -->
<section class="section adv" id="voordelen">
  <div class="container">
    <header class="sechead sechead--center reveal">
      <p class="eyebrow eyebrow--center"><span class="eyebrow__bar"></span>Onze afspraken</p>
      <h2 class="h2">Vijf afspraken die we <em>op papier</em> zetten</h2>
      <p class="sechead__sub">Klanten schrijven het in hun reviews: we komen onze afspraken na. Daarom staan ze zwart op wit.</p>
    </header>

    <ol class="steps">
      <li class="steps__item reveal">
        <span class="steps__num">01</span>
        <h3>Gratis plaatsbezoek</h3>
        <!-- ⚠️ CONFIRM C-21: komt Magomed zelf op plaatsbezoeken? -->
        <p data-confirm="C-21">We komen ter plaatse, bekijken uw dak van dichtbij en luisteren naar wat u wilt en wat u wilt uitgeven.</p>
      </li>
      <li class="steps__item reveal">
        <span class="steps__num">02</span>
        <h3>Offerte binnen {facts.quoteHoursAfterVisit} uur</h3>
        <!-- ⚠️ CONFIRM C-21: wordt de offerte per positie opgesteld, incl. "wat niet inbegrepen is"? -->
        <p data-confirm="C-21">Per post uitgeschreven: wat we doen, met welk materiaal, wat het kost. En ook wat er niet in zit.</p>
      </li>
      <li class="steps__item reveal">
        <span class="steps__num">03</span>
        <h3>Startdatum en planning op papier</h3>
        <p>Na uw akkoord krijgt u een vaste startdatum. Een hellend dak van een rijwoning duurt meestal 5 tot 10 werkdagen.</p>
      </li>
      <li class="steps__item reveal">
        <span class="steps__num">04</span>

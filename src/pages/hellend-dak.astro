    'Containers, valbeveiliging en opruim zitten in de prijs',
    'Hulp bij uw premieaanvraag',
  ],
  doImages: [
    { src: '/assets/work/work-09.webp', alt: 'Bungalow met nieuwe antracietkleurige dakpannen', w: 1600, h: 900 },

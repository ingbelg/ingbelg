---
interface Props {
  title?: string;
  description?: string;
}
const {
  title = 'INGBELG — Algemene dakwerken en renovatie | Platte & hellende daken',
  description = 'INGBELG is uw specialist in dakwerken en algemene renovatie: platte daken, hellende daken, timmerwerken, gevelbekleding, zonnepanelen en ecopanelen. Gratis offerte binnen 48u.',
} = Astro.props;
---

<!DOCTYPE html>
<html lang="nl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{title}</title>
<meta name="description" content={description}>
<meta name="theme-color" content="#ffffff">
<link rel="icon" href="/assets/favicon.svg" type="image/svg+xml">
<link rel="icon" href="/assets/favicon-32.png" type="image/png" sizes="32x32">
<link rel="apple-touch-icon" href="/assets/apple-touch-icon.png">
<meta property="og:title" content="INGBELG — Algemene dakwerken en renovatie">
<meta property="og:description" content="Kwaliteit in werk, materiaal en service. Gratis offerte binnen 48u.">
<meta property="og:image" content="/assets/logo.png">
<meta property="og:type" content="website">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Roboto+Condensed:wght@400;500;600;700&family=Nunito:wght@300;400;600;700;800&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/css/style.css">
<script is:inline type="application/ld+json" set:html={JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'RoofingContractor',
  name: 'INGBELG',
  alternateName: 'IngBelg Dakwerken',
  image: 'https://ingbelg.be/assets/logo-transparent.png',
  url: 'https://ingbelg.be',
  telephone: '+32488876061',
  email: 'info@ingbelg.be',
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'Hoogstraat 59',
    postalCode: '9620',
    addressLocality: 'Zottegem',
    addressCountry: 'BE',
  },
  geo: {
    '@type': 'GeoCoordinates',
    latitude: 50.8696,
    longitude: 3.8107,
  },
  areaServed: ['Oost-Vlaanderen', 'West-Vlaanderen', 'Vlaams-Brabant', 'Antwerpen'],
  openingHoursSpecification: {
    '@type': 'OpeningHoursSpecification',
    dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'],
    opens: '08:00',
    closes: '18:00',
  },
  sameAs: ['https://maps.app.goo.gl/cxndFzpCFZBJqECCA'],
  aggregateRating: {
    '@type': 'AggregateRating',
    ratingValue: '5.0',
    bestRating: '5',
    reviewCount: '54',
  },
})} />
</head>
<body>
<slot />
<script is:inline src="/js/calculator.js"></script>
<script is:inline src="/js/main.js"></script>
</body>
</html>

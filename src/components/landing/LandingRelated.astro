---
/* Dienst-/gidspagina — VERWANTE UITLEG */
import type { LandingData } from '../../types/pages';

interface Props { page: LandingData }
const { page } = Astro.props;
---
{page.related && (
  <section class="section" style="padding-block:clamp(36px,5vw,64px)">
    <div class="container">
      <p class="lead reveal" style="max-width:820px;margin-inline:auto;text-align:center">{page.related.text} <a href={page.related.href}><strong>{page.related.label}</strong></a></p>
    </div>
  </section>
)}

---
/* Dienst-/gidspagina — GOED OM TE WETEN (premie/btw) */
import type { LandingData } from '../../types/pages';
import { pageKinds } from '../../lib/page-kind';

interface Props { page: LandingData }
const { page } = Astro.props;
const { isGuide } = pageKinds(page);
---
{page.note && (
  <section class="section section--soft" id="goed-om-te-weten">
    <div class="container">
      <header class="sechead sechead--center reveal">
        <h2 class="h2" set:html={page.note.title}></h2>
      </header>
      <p class="lead reveal" style="max-width:820px;margin-inline:auto;text-align:center">{page.note.text}</p>
      <p class="reveal" style="text-align:center;margin-top:28px;display:flex;gap:14px;justify-content:center;flex-wrap:wrap">
        <a class="btn btn--primary" href="/#calculator"><span>Bereken uw premie</span></a>
        {!isGuide && <a class="btn btn--line" href="/premies-dakwerken-2026"><span>Alles over de premies 2026</span></a>}
      </p>
    </div>
  </section>
)}

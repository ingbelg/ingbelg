---
/* Dienst-/gidspagina — ZO GAAT HET */
import type { LandingData } from '../../types/pages';

interface Props { page: LandingData }
const { page } = Astro.props;
---
<section class="section adv" id="voordelen">
  <div class="container">
    <header class="sechead sechead--center reveal">
      <p class="eyebrow eyebrow--center"><span class="eyebrow__bar"></span>Zo gaat het</p>
      <h2 class="h2">Van eerste bezoek tot <em>oplevering</em></h2>
    </header>
    <ol class="steps">
      {page.steps.map((s, i) => (
        <li class="steps__item reveal">
          <span class="steps__num">{String(i + 1).padStart(2, '0')}</span>
          <h3>{s.h}</h3>
          <p>{s.p}</p>
        </li>
      ))}
    </ol>
  </div>
</section>

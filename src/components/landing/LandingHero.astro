---
/* Dienst-/gidspagina — HERO */
import facts from '../../data/site-facts.json';
import type { LandingData } from '../../types/pages';
import { pageKinds } from '../../lib/page-kind';

interface Props { page: LandingData }
const { page } = Astro.props;
const { guide } = pageKinds(page);
const wa = `https://wa.me/${facts.phoneE164.replace('+', '')}?text=${encodeURIComponent('Hallo INGBELG, hierbij een foto van mijn dak. Mijn gemeente: ')}`;
---
<section class="hero" id="top">
  <div class="hero__media">
    <img class="hero__video" src={page.hero.src} srcset={page.hero.srcset} sizes={page.hero.srcset ? '100vw' : undefined} alt={page.hero.alt} width="1600" height="900" fetchpriority="high" decoding="async">
    <div class="hero__scrim"></div>
    <div class="hero__grain"></div>
  </div>
  <div class="container hero__in">
    <nav class="crumbs" aria-label="Kruimelpad">
      <ol>
        <li><a href="/">Home</a></li>
        {guide && <li><a href={guide.parent.href}>{guide.parent.name}</a></li>}
        <li aria-current="page">{page.crumb}</li>
      </ol>
    </nav>
    <p class="hero__eyebrow"><span class="hero__dot"></span><span class="hero__eyebrow-txt">{page.eyebrow}</span></p>
    <h1 class="hero__title">
      <span class="h1-main">{page.h1Main}</span>
      <span class="h1-sub">{page.h1Sub}</span>
    </h1>
    <p class="hero__lead">{page.lead}</p>
    <div class="hero__cta">
      <a class="btn btn--primary btn--lg" href="#contact"><span>Vraag een gratis plaatsbezoek</span></a>
      <a class="btn btn--glass btn--lg" href={`tel:${facts.phoneE164}`}><span>{facts.phone}</span></a>
    </div>
    <p class="hero__note">Gratis en vrijblijvend &middot; we bellen u binnen {facts.callbackWorkdays} werkdag terug voor een afspraak &middot; <a href={wa} target="_blank" rel="noopener">Stuur een foto via WhatsApp</a></p>
  </div>
</section>

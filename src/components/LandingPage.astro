---
/* Eén sjabloon voor de advertentie-/dienstpagina's (hellend dak, plat dak, asbestdak).
   Hergebruikt de bestaande klassen, het offerteformulier (#offerteForm → /api/contact → e-mail + Odoo)
   en de cookie-/consentlogica. Bevat bewust GEEN eigen CSS en geen eigen JS.
   Teksten komen uit de pagina-bestanden en mogen enkel bevestigde feiten bevatten (zie site-facts.json). */
import Layout from '../layouts/Layout.astro';
import Topbar from './site/Topbar.astro';
import SiteHeader from './site/SiteHeader.astro';
import SiteFooter from './site/SiteFooter.astro';
import ContactSection from './site/ContactSection.astro';
import LandingHero from './landing/LandingHero.astro';
import TrustBar from './landing/TrustBar.astro';
import LandingProblems from './landing/LandingProblems.astro';
import GuideOverview from './landing/GuideOverview.astro';
import GuideBody from './landing/GuideBody.astro';
import ServiceDo from './landing/ServiceDo.astro';
import ServicePhotos from './landing/ServicePhotos.astro';
import LandingReviews from './landing/LandingReviews.astro';
import LandingSteps from './landing/LandingSteps.astro';
import LandingNote from './landing/LandingNote.astro';
import LandingRelated from './landing/LandingRelated.astro';
import LandingCta from './landing/LandingCta.astro';
import LandingFaq from './landing/LandingFaq.astro';
import LandingSchema from './landing/LandingSchema.astro';
import { FOOTER_SERVICES_LANDING } from '../data/navigation';
import facts from '../data/site-facts.json';

export type { LandingData } from '../types/pages';
import type { LandingData } from '../types/pages';

interface Props { page: LandingData }
const { page } = Astro.props;
import Icon from './site/Icon.astro';
---
<Layout title={page.title} description={page.description} image={page.ogImage}>

<a class="skip-link" href="#main">Ga naar inhoud</a>

{/* ============ TOPBAR ============ */}
<Topbar />

{/* ============ HEADER (zonder menu: één doel = het formulier) ============ */}
<SiteHeader brandHref="/" brandLabel="INGBELG — naar de startpagina" />

<main id="main">
{/* ============ HERO ============ */}
<LandingHero page={page} />

{/* ============ VERTROUWEN ============ */}
<TrustBar page={page} />

{/* ============ HERKENT U DIT? ============ */}
<LandingProblems page={page} />

{/* ============ OVERZICHT UITLEGPAGINA'S (enkel bij kind="overview") ============ */}
<GuideOverview page={page} />

{/* ============ GIDS (enkel kind="guide") ============ */}
<GuideBody page={page} />

{/* ============ WAT WE DOEN ============ */}
<ServiceDo page={page} />

{/* ============ VOOR/NA + FOTO'S ============ */}
<ServicePhotos page={page} />

{/* ============ REVIEWS (Trustindex, pas na toestemming) ============ */}
<LandingReviews page={page} />

{/* ============ ZO GAAT HET ============ */}
<LandingSteps page={page} />
<LandingNote page={page} />
<LandingRelated page={page} />

{/* ============ CTA ============ */}
<LandingCta page={page} />

{/* ============ FAQ ============ */}
<LandingFaq page={page} />
<LandingSchema page={page} />

{/* ============ CONTACT ============ */}
<ContactSection dienst={page.dienst} sourceBlock={`Landingspagina /${page.slug}`} />

</main>

{/* ============ FOOTER ============ */}
<SiteFooter services={FOOTER_SERVICES_LANDING} />

<div class="mobilebar">
  <a href={`tel:${facts.phoneE164}`}><Icon name="phone" decorative={false} />Bellen</a>
  <a href={`https://wa.me/${facts.phoneE164.replace('+', '')}`} target="_blank" rel="noopener"><Icon name="whatsapp" decorative={false} />WhatsApp</a>
  <a class="mobilebar__cta" href="#contact">Plaatsbezoek</a>
</div>

</Layout>

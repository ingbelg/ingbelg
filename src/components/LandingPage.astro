---
/* Eén sjabloon voor de advertentie-/dienstpagina's (hellend dak, plat dak, asbestdak).
   Hergebruikt de bestaande klassen, het offerteformulier (#offerteForm → /api/contact → e-mail + Odoo)
   en de cookie-/consentlogica. Bevat bewust GEEN eigen CSS en geen eigen JS.
   Teksten komen uit de pagina-bestanden en mogen enkel bevestigde feiten bevatten (zie site-facts.json). */
import Layout from '../layouts/Layout.astro';
import facts from '../data/site-facts.json';

export interface LandingData {
  slug: string;                 // bv. "hellend-dak" (zonder slash)
  title: string;
  description: string;
  dienst: string;               // moet exact overeenkomen met een <option value> van het formulier
  eyebrow: string;
  h1Main: string;
  crumb: string;                // korte naam in het kruimelpad (zichtbaar + BreadcrumbList)
  parent?: { name: string; href: string }; // tussenstap in het kruimelpad (bv. Handig om te weten)
  articles?: { href: string; title: string; text: string; tag: string; img: string; alt: string; w: number; h: number }[]; // overzicht van uitlegpagina's
  h1Sub: string;
  lead: string;
  hero: { src: string; alt: string; srcset?: string };
  ogImage?: string;
  problems: { h: string; p: string }[];
  problemsTitle?: string;       // standaard: "Herkent u dit?" (HTML toegestaan: <em>)
  kind?: 'service' | 'guide';   // 'guide' = informatieve pagina (geen Service-schema, geen "Onze aanpak"-blok)
  published?: string;           // ISO-datum eerste publicatie, bv. "2026-10-03" (enkel voor guide → Article-schema)
  updated?: string;             // ISO-datum laatste controle met de bronnen (zichtbaar + dateModified)
  guide?: { h: string; paras?: string[]; list?: string[]; bullets?: boolean; table?: { head: string[]; rows: string[][] } }[];
  sources?: { label: string; href: string }[];
  doTitle?: string;             // titel van "wat we doen" (HTML toegestaan: <em>)
  doLead?: string;
  doTicks?: string[];
  doImages?: { src: string; alt: string; w: number; h: number }[]; // 2 beelden
  ba?: boolean;                 // voor/na-sliders tonen
  photos?: { src: string; alt: string; w: number; h: number }[];
  steps: { h: string; p: string }[];
  note?: { title: string; text: string };
  related?: { text: string; href: string; label: string }; // verwijzing naar een verwante uitlegpagina (komt boven de CTA)   // extra blok (premie/btw/asbestregels)
  faq: { q: string; a: string }[];
  serviceType: string;
}

interface Props { page: LandingData }
const { page } = Astro.props;
const wa = `https://wa.me/${facts.phoneE164.replace('+', '')}?text=${encodeURIComponent('Hallo INGBELG, hierbij een foto van mijn dak. Mijn gemeente: ')}`;
const siteUrl = (Astro.site ?? new URL(facts.siteUrl)).origin;
const pageUrl = `${siteUrl}/${page.slug}`;
const isGuide = page.kind === 'guide';
const isArticle = isGuide && !page.articles && !!page.updated;
const nlDate = (iso: string) => new Date(iso + 'T12:00:00Z').toLocaleDateString('nl-BE', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' });
---
<Layout title={page.title} description={page.description} image={page.ogImage}>

<a class="skip-link" href="#main">Ga naar inhoud</a>

{/* ============ TOPBAR ============ */}
<div class="topbar">
  <div class="container topbar__in">
    <div class="topbar__left">
      <a class="topbar__item" href={`tel:${facts.phoneE164}`}>
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6.6 10.8a15.1 15.1 0 0 0 6.6 6.6l2.2-2.2a1 1 0 0 1 1-.25c1.1.37 2.3.57 3.6.57a1 1 0 0 1 1 1V20a1 1 0 0 1-1 1A17 17 0 0 1 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1c0 1.3.2 2.5.57 3.6a1 1 0 0 1-.25 1z"/></svg>
        <span>{facts.phone}</span>
      </a>
      <a class="topbar__item" href={`https://wa.me/${facts.phoneE164.replace('+', '')}`} target="_blank" rel="noopener">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2a10 10 0 0 0-8.6 15L2 22l5.2-1.4A10 10 0 1 0 12 2m5.1 14.1c-.2.6-1.2 1.2-1.7 1.2s-1.1.2-3.6-.8-4-3.5-4.2-3.7-1.2-1.6-1.2-3 .8-2.1 1-2.4.6-.3.8-.3h.6c.2 0 .4 0 .7.5s.9 2.1 1 2.3.1.3 0 .5-.2.5-.4.7-.4.4-.2.7 1 1.5 2 2.4a8 8 0 0 0 2.1 1.2c.3.2.5.1.7-.1l.9-1.1c.2-.3.4-.2.7-.1l2 1c.3.1.5.2.6.3s.1.7-.1 1.3"/></svg>
        <span>WhatsApp</span>
      </a>
      <a class="topbar__item topbar__rating" href={facts.reviews.googleUrl} target="_blank" rel="noopener">
        <span aria-hidden="true">★</span>
        <span>{facts.reviews.score} · {facts.reviews.count} reviews</span>
      </a>
      <span class="topbar__item topbar__item--muted">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2a7 7 0 0 0-7 7c0 5.25 7 13 7 13s7-7.75 7-13a7 7 0 0 0-7-7m0 9.5A2.5 2.5 0 1 1 14.5 9 2.5 2.5 0 0 1 12 11.5"/></svg>
        <span>{facts.address.street}, {facts.address.city}</span>
      </span>
    </div>
    <div class="topbar__right">
      <span class="topbar__badge">BTW {facts.vat}</span>
    </div>
  </div>
</div>

{/* ============ HEADER (zonder menu: één doel = het formulier) ============ */}
<header class="header" id="header">
  <div class="container header__in">
    <a class="brand" href="/" aria-label="INGBELG — naar de startpagina">
      <img src="/assets/logo-transparent.png" alt="INGBELG — algemene dakwerken en renovatie" width="430" height="207">
    </a>
    <div class="header__actions">
      <a class="btn btn--line btn--icon" href={`tel:${facts.phoneE164}`} aria-label={`Bel ${facts.phone}`} title={facts.phone}>
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6.6 10.8a15.1 15.1 0 0 0 6.6 6.6l2.2-2.2a1 1 0 0 1 1-.25c1.1.37 2.3.57 3.6.57a1 1 0 0 1 1 1V20a1 1 0 0 1-1 1A17 17 0 0 1 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1c0 1.3.2 2.5.57 3.6a1 1 0 0 1-.25 1z"/></svg>
      </a>
      <a class="btn btn--primary" href="#contact">
        <span>Gratis plaatsbezoek</span>
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h13M13 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </a>
    </div>
  </div>
</header>

<main id="main">
{/* ============ HERO ============ */}
<section class="hero" id="top">
  <div class="hero__media">
    <img class="hero__video" src={page.hero.src} srcset={page.hero.srcset} sizes={page.hero.srcset ? '100vw' : undefined} alt={page.hero.alt} width="1600" height="900" fetchpriority="high" decoding="async">
    <div class="hero__scrim"></div>
    <div class="hero__grain"></div>
  </div>
  <div class="container hero__in">
    <nav class="crumbs" aria-label="Kruimelpad">
      <ol>
        <li><a href="/">Home</a></li>
        {page.parent && <li><a href={page.parent.href}>{page.parent.name}</a></li>}
        <li aria-current="page">{page.crumb}</li>
      </ol>
    </nav>
    <p class="hero__eyebrow"><span class="hero__dot"></span><span class="hero__eyebrow-txt">{page.eyebrow}</span></p>
    <h1 class="hero__title">
      <span class="h1-main">{page.h1Main}</span>
      <span class="h1-sub">{page.h1Sub}</span>
    </h1>
    <p class="hero__lead">{page.lead}</p>
    <div class="hero__cta">
      <a class="btn btn--primary btn--lg" href="#contact"><span>Vraag een gratis plaatsbezoek</span></a>
      <a class="btn btn--glass btn--lg" href={`tel:${facts.phoneE164}`}><span>{facts.phone}</span></a>
    </div>
    <p class="hero__note">Gratis en vrijblijvend &middot; we bellen u binnen {facts.callbackWorkdays} werkdag terug voor een afspraak &middot; <a href={wa} target="_blank" rel="noopener">Stuur een foto via WhatsApp</a></p>
  </div>
</section>

{/* ============ VERTROUWEN ============ */}
<section class="brands">
  <div class="container">
    <p class="brands__label">Zo werken wij:</p>
    <ul class="brands__row">
      <li>Volgens de WTCB-richtlijnen</li>
      <li>Verzekerd</li>
      <li>{facts.warrantyYears} jaar schriftelijke garantie</li>
      <li>{facts.roofsDone}+ daken gerealiseerd</li>
    </ul>
  </div>
</section>

{/* ============ HERKENT U DIT? ============ */}
{page.problems.length > 0 && (
<section class="section usp" id="usp">
  <div class="container">
    <header class="sechead sechead--center">
      <h2 class="h2" set:html={page.problemsTitle ?? 'Herkent u <em>dit</em>?'}></h2>
    </header>
    <div class="adv__grid">
      {page.problems.map((x) => (
        <article class="adv__card reveal">
          <h3>{x.h}</h3>
          <p>{x.p}</p>
        </article>
      ))}
    </div>
  </div>
</section>
)}

{/* ============ OVERZICHT UITLEGPAGINA'S (enkel als page.articles) ============ */}
{page.articles && (
<section class="section usp" id="artikels">
  <div class="container">
    <h2 class="sr-only">Alle uitleg</h2>
    <div class="articles">
      {page.articles.map((a) => (
        <article class="svc reveal">
          <div class="svc__img"><img src={a.img} alt={a.alt} width={a.w} height={a.h} loading="lazy"></div>
          <div class="svc__body">
            <ul class="svc__tags"><li>{a.tag}</li></ul>
            <h3><a href={a.href}>{a.title}</a></h3>
            <p>{a.text}</p>
            <a class="svc__more" href={a.href}>Lees de uitleg</a>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
)}

{/* ============ GIDS (enkel kind="guide") ============ */}
{page.guide && (
  <section class="section" id="gids">
    <div class="container legal">
      <div class="legal__body">
        {page.updated && <p class="sechead__sub" style="margin-top:0">Laatst nagekeken met de officiële bronnen: <time datetime={page.updated}>{nlDate(page.updated)}</time>.</p>}
        {page.guide.map((g) => (
          <>
            {g.h && <h2>{g.h}</h2>}
            {g.paras && g.paras.map((t) => <p set:html={t}></p>)}
            {g.list && (g.bullets ? <ul>{g.list.map((t) => <li set:html={t}></li>)}</ul> : <ul class="ticks" style="list-style:none;padding-left:0">{g.list.map((t) => <li set:html={t}></li>)}</ul>)}
            {g.table && (
              <div class="legal__tablewrap">
                <table class="legal__table">
                  <thead><tr>{g.table.head.map((c) => <th>{c}</th>)}</tr></thead>
                  <tbody>{g.table.rows.map((r) => <tr>{r.map((c) => <td set:html={c}></td>)}</tr>)}</tbody>
                </table>
              </div>
            )}
          </>
        ))}
        {page.sources && (
          <>
            <h2>Bronnen</h2>
            <ul>{page.sources.map((x) => <li><a href={x.href} target="_blank" rel="noopener">{x.label}</a></li>)}</ul>
          </>
        )}
      </div>
    </div>
  </section>
)}

{/* ============ WAT WE DOEN ============ */}
{page.doTitle && page.doImages && (
<section class="about section section--soft" id="aanpak">
  <div class="container about__grid">
    <div class="about__media reveal">
      <div class="about__img about__img--main">
        <img src={page.doImages[0].src} alt={page.doImages[0].alt} width={page.doImages[0].w} height={page.doImages[0].h} loading="lazy">
      </div>
      <div class="about__img about__img--sub">
        <img src={page.doImages[1].src} alt={page.doImages[1].alt} width={page.doImages[1].w} height={page.doImages[1].h} loading="lazy">
      </div>
    </div>
    <div class="about__body reveal">
      <p class="eyebrow"><span class="eyebrow__bar"></span>Onze aanpak</p>
      <h2 class="h2" set:html={page.doTitle}></h2>
      <p class="lead">{page.doLead}</p>
      <ul class="ticks">
        {(page.doTicks ?? []).map((t) => <li>{t}</li>)}
      </ul>
      <div class="about__cta">
        <a class="btn btn--primary" href="#contact"><span>Vraag een gratis plaatsbezoek</span></a>
        <a class="btn btn--line" href={`tel:${facts.phoneE164}`}><span>{facts.phone}</span></a>
      </div>
    </div>
  </div>
</section>
)}

{/* ============ VOOR/NA + FOTO'S ============ */}
{(page.ba || (page.photos && page.photos.length)) && (
  <section class="section" id="realisaties">
    <div class="container">
      <header class="sechead sechead--center reveal">
        <p class="eyebrow eyebrow--center"><span class="eyebrow__bar"></span>Uit onze praktijk</p>
        <h2 class="h2">Dit leveren we <em>op</em></h2>
      </header>
      {page.ba && (
        <div class="ba-grid reveal">
          <div class="ba">
            <div class="ba__slider">
              <div class="ba__img ba__img--before"><img src="/assets/na_antrociet.webp" alt="Dak na renovatie — antraciet dakpannen" width="1024" height="576" loading="lazy"></div>
              <div class="ba__img ba__img--after"><img src="/assets/voor_antrociet.webp" alt="Dak voor renovatie — antraciet dakpannen" width="1024" height="768" loading="lazy"></div>
              <input class="ba__range" type="range" min="0" max="100" value="50" aria-label="Sleep om voor en na te vergelijken">
              <div class="ba__handle" aria-hidden="true"></div>
              <span class="ba__tag ba__tag--before">Voor</span>
              <span class="ba__tag ba__tag--after">Na</span>
            </div>
            <p class="ba__label">Antraciet dakpannen &middot; hellend dak &middot; INGBELG-werf</p>
          </div>
          <div class="ba">
            <div class="ba__slider">
              <div class="ba__img ba__img--before"><img src="/assets/na_rood.webp" alt="Dak na renovatie — rode dakpannen" width="1024" height="768" loading="lazy" style="object-position:center 15%"></div>
              <div class="ba__img ba__img--after"><img src="/assets/voor_rood.webp" alt="Dak voor renovatie — rode dakpannen" width="1024" height="676" loading="lazy"></div>
              <input class="ba__range" type="range" min="0" max="100" value="50" aria-label="Sleep om voor en na te vergelijken">
              <div class="ba__handle" aria-hidden="true"></div>
              <span class="ba__tag ba__tag--before">Voor</span>
              <span class="ba__tag ba__tag--after">Na</span>
            </div>
            <p class="ba__label">Rode dakpannen &middot; hellend dak &middot; INGBELG-werf</p>
          </div>
        </div>
      )}
      {page.photos && page.photos.length > 0 && (
        <div class="roof__stack" style="display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:18px;margin-top:28px">
          {page.photos.map((ph) => (
            <img src={ph.src} alt={ph.alt} width={ph.w} height={ph.h} loading="lazy" style="width:100%;height:auto;border-radius:14px;display:block">
          ))}
        </div>
      )}
    </div>
  </section>
)}

{/* ============ REVIEWS (Trustindex, pas na toestemming) ============ */}
<section class="section section--soft" id="reviews">
  <div class="container">
    <header class="sechead sechead--center reveal">
      <p class="eyebrow eyebrow--center"><span class="eyebrow__bar"></span>Wat klanten zeggen</p>
      <h2 class="h2">Wat klanten zeggen <em>na de oplevering</em></h2>
      <p class="sechead__sub">{facts.reviews.score}/5 op Google, op basis van {facts.reviews.count} reviews.</p>
    </header>
    <p class="sechead sechead--center reveal" style="margin-bottom:36px">
      <a class="btn btn--line" href={facts.reviews.googleUrl} target="_blank" rel="noopener"><span>Alle reviews op Google →</span></a>
    </p>
    <div class="reviews-widget reveal">
      <div class="ti-slot" data-ti="30693eb81611346370764c8da82">
        <div class="ti-placeholder">
          <p><strong>Google-reviews</strong><br>Onze reviews worden getoond door Trustindex, een externe dienst. Uw gegevens worden pas met die dienst gedeeld nadat u dit toestaat.</p>
          <button type="button" class="btn btn--primary" data-consent-external><span>Toestaan en reviews tonen</span></button>
        </div>
      </div>
    </div>
  </div>
</section>

{/* ============ ZO GAAT HET ============ */}
<section class="section adv" id="voordelen">
  <div class="container">
    <header class="sechead sechead--center reveal">
      <p class="eyebrow eyebrow--center"><span class="eyebrow__bar"></span>Zo gaat het</p>
      <h2 class="h2">Van eerste bezoek tot <em>oplevering</em></h2>
    </header>
    <ol class="steps">
      {page.steps.map((s, i) => (
        <li class="steps__item reveal">
          <span class="steps__num">{String(i + 1).padStart(2, '0')}</span>
          <h3>{s.h}</h3>
          <p>{s.p}</p>
        </li>
      ))}
    </ol>
  </div>
</section>

{page.note && (
  <section class="section section--soft" id="goed-om-te-weten">
    <div class="container">
      <header class="sechead sechead--center reveal">
        <h2 class="h2" set:html={page.note.title}></h2>
      </header>
      <p class="lead reveal" style="max-width:820px;margin-inline:auto;text-align:center">{page.note.text}</p>
      <p class="reveal" style="text-align:center;margin-top:28px;display:flex;gap:14px;justify-content:center;flex-wrap:wrap">
        <a class="btn btn--primary" href="/#calculator"><span>Bereken uw premie</span></a>
        {!isGuide && <a class="btn btn--line" href="/premies-dakwerken-2026"><span>Alles over de premies 2026</span></a>}
      </p>
    </div>
  </section>
)}

{page.related && (
  <section class="section" style="padding-block:clamp(36px,5vw,64px)">
    <div class="container">
      <p class="lead reveal" style="max-width:820px;margin-inline:auto;text-align:center">{page.related.text} <a href={page.related.href}><strong>{page.related.label}</strong></a></p>
    </div>
  </section>
)}

{/* ============ CTA ============ */}
<section class="cta">
  <div class="container cta__in reveal">
    <div>
      <h2 class="cta__title">Eén plaatsbezoek. <em>Daarna weet u het.</em></h2>
      <p class="cta__sub">Daarna weet u wat uw dak nodig heeft en wat het kost. Gratis en vrijblijvend. U beslist pas als u de offerte in handen hebt.</p>
    </div>
    <div class="cta__actions">
      <a class="btn btn--white btn--lg" href="#contact"><span>Vraag een gratis plaatsbezoek</span></a>
      <a class="btn btn--glass btn--lg" href={`tel:${facts.phoneE164}`}><span>{facts.phone}</span></a>
    </div>
  </div>
</section>

{/* ============ FAQ ============ */}
<section class="section section--soft" id="faq">
  <div class="container faq__wrap">
    <div class="faq__intro reveal">
      <p class="eyebrow"><span class="eyebrow__bar"></span>FAQ</p>
      <h2 class="h2">Veelgestelde <em>vragen</em></h2>
      <p class="sechead__sub">Staat uw vraag er niet bij? Bel ons gerust, we helpen u meteen verder.</p>
      <a class="btn btn--line" href={`tel:${facts.phoneE164}`}><span>{facts.phone}</span></a>
    </div>
    <div class="faq">
      {page.faq.map((item) => (
        <details class="faq__item reveal">
          <summary>{item.q}<i></i></summary>
          <div class="faq__body"><p>{item.a}</p></div>
        </details>
      ))}
    </div>
  </div>
</section>

<script type="application/ld+json" set:html={JSON.stringify({
  '@context': 'https://schema.org',
  '@graph': [
    isGuide
      ? {
          '@type': page.articles ? 'CollectionPage' : 'WebPage',
          '@id': `${pageUrl}#webpage`,
          name: page.title,
          url: pageUrl,
          inLanguage: 'nl-BE',
          isPartOf: { '@id': new URL('/#business', siteUrl).href },
        }
      : {
          '@type': 'Service',
          '@id': `${pageUrl}#service`,
          name: page.dienst,
          serviceType: page.serviceType,
          url: pageUrl,
          provider: { '@id': new URL('/#business', siteUrl).href },
          areaServed: { '@type': 'AdministrativeArea', name: 'Oost-Vlaanderen' },
        },
    ...(isArticle
      ? [{
          '@type': 'Article',
          '@id': `${pageUrl}#article`,
          headline: page.title.replace(/ \| INGBELG$/, ''),
          description: page.description,
          image: new URL(page.ogImage ?? page.hero.src, siteUrl).href,
          inLanguage: 'nl-BE',
          datePublished: page.published ?? page.updated,
          dateModified: page.updated,
          mainEntityOfPage: { '@id': `${pageUrl}#webpage` },
          author: { '@id': new URL('/#business', siteUrl).href },
          publisher: { '@id': new URL('/#business', siteUrl).href },
        }]
      : []),
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: new URL('/', siteUrl).href },
        ...(page.parent ? [{ '@type': 'ListItem', position: 2, name: page.parent.name, item: new URL(page.parent.href, siteUrl).href }] : []),
        { '@type': 'ListItem', position: page.parent ? 3 : 2, name: page.crumb, item: pageUrl },
      ],
    },
    {
      '@type': 'FAQPage',
      mainEntity: page.faq.map((item) => ({
        '@type': 'Question',
        name: item.q,
        acceptedAnswer: { '@type': 'Answer', text: item.a },
      })),
    },
  ],
})} />

{/* ============ CONTACT ============ */}
<section class="section contact" id="contact">
  <div class="container">
    <header class="sechead sechead--center reveal">
      <p class="eyebrow eyebrow--center"><span class="eyebrow__bar"></span>Contact</p>
      <h2 class="h2">Vraag uw <em>gratis plaatsbezoek</em> aan</h2>
      <p class="sechead__sub">Vul het formulier in, bel of stuur een WhatsApp. We bellen u binnen {facts.callbackWorkdays} werkdag terug om een moment af te spreken.</p>
    </header>

    <div class="contact__grid">
      <div class="contact__info">
        <a class="cinfo reveal" href={`tel:${facts.phoneE164}`}>
          <span class="cinfo__ico"><svg viewBox="0 0 24 24"><path d="M6.6 10.8a15.1 15.1 0 0 0 6.6 6.6l2.2-2.2a1 1 0 0 1 1-.25c1.1.37 2.3.57 3.6.57a1 1 0 0 1 1 1V20a1 1 0 0 1-1 1A17 17 0 0 1 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1c0 1.3.2 2.5.57 3.6a1 1 0 0 1-.25 1z"/></svg></span>
          <span class="cinfo__txt"><strong>Telefoon</strong><em>{facts.phone}</em></span>
        </a>
        <a class="cinfo reveal" href={`https://wa.me/${facts.phoneE164.replace('+', '')}`} target="_blank" rel="noopener">
          <span class="cinfo__ico"><svg viewBox="0 0 24 24"><path d="M12 2a10 10 0 0 0-8.6 15L2 22l5.2-1.4A10 10 0 1 0 12 2m5.1 14.1c-.2.6-1.2 1.2-1.7 1.2s-1.1.2-3.6-.8-4-3.5-4.2-3.7-1.2-1.6-1.2-3 .8-2.1 1-2.4.6-.3.8-.3h.6c.2 0 .4 0 .7.5s.9 2.1 1 2.3.1.3 0 .5-.2.5-.4.7-.4.4-.2.7 1 1.5 2 2.4a8 8 0 0 0 2.1 1.2c.3.2.5.1.7-.1l.9-1.1c.2-.3.4-.2.7-.1l2 1c.3.1.5.2.6.3s.1.7-.1 1.3"/></svg></span>
          <span class="cinfo__txt"><strong>WhatsApp</strong><em>{facts.phone}</em></span>
        </a>
        <a class="cinfo reveal" href={`mailto:${facts.email}`}>
          <span class="cinfo__ico"><svg viewBox="0 0 24 24"><path d="M20 4H4a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V6a2 2 0 0 0-2-2m0 4-8 5-8-5V6l8 5 8-5z"/></svg></span>
          <span class="cinfo__txt"><strong>E-mail</strong><em>{facts.email}</em></span>
        </a>
        <a class="cinfo reveal" href="https://maps.google.com/?q=Hoogstraat+59+Zottegem" target="_blank" rel="noopener">
          <span class="cinfo__ico"><svg viewBox="0 0 24 24"><path d="M12 2a7 7 0 0 0-7 7c0 5.25 7 13 7 13s7-7.75 7-13a7 7 0 0 0-7-7m0 9.5A2.5 2.5 0 1 1 14.5 9 2.5 2.5 0 0 1 12 11.5"/></svg></span>
          <span class="cinfo__txt"><strong>Adres</strong><em>{facts.address.street}, {facts.address.postalCode} {facts.address.city}</em></span>
        </a>
        <div class="cinfo cinfo--static reveal">
          <span class="cinfo__ico"><svg viewBox="0 0 24 24"><path fill-rule="evenodd" d="M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20m1 4h-2v7.4l5.2 3.1 1-1.7-4.2-2.5z"/></svg></span>
          <span class="cinfo__txt">
            <strong>Openingsuren</strong>
            {facts.openingHours.map((slot) => <em>{slot.label}: {slot.opens} – {slot.closes}</em>)}
            {facts.closedDays.map((day) => <em>{day}: gesloten</em>)}
          </span>
        </div>
      </div>

      <form class="cform reveal" id="offerteForm" novalidate>
        <div class="cform__row">
          <label class="field">
            <span>Naam <i>*</i></span>
            <input type="text" name="naam" required placeholder="Uw voor- en achternaam">
          </label>
          <label class="field">
            <span>Telefoon <i>*</i></span>
            <input type="tel" name="telefoon" required placeholder="+32 4.. .. .. ..">
          </label>
        </div>
        <div class="cform__row">
          <label class="field">
            <span>E-mail <i>*</i></span>
            <input type="email" name="email" required placeholder="naam@voorbeeld.be">
          </label>
          <label class="field">
            <span>Gemeente <i>*</i></span>
            <input type="text" name="gemeente" required placeholder="Bv. Zottegem">
          </label>
        </div>
        <label class="field">
          <span>Wat moet er gebeuren? <i>*</i></span>
          <select name="dienst" required>
            <option value="">Kies een dienst…</option>
            <option value="Hellende daken" selected={page.dienst === 'Hellende daken'}>Hellend dak</option>
            <option value="Platte daken" selected={page.dienst === 'Platte daken'}>Plat dak</option>
            <option value="Asbestdak vervangen" selected={page.dienst === 'Asbestdak vervangen'}>Asbestdak vervangen</option>
            <option value="Gevelbekleding" selected={page.dienst === 'Gevelbekleding'}>Gevelbekleding</option>
            <option value="Timmerwerken en dakkapellen" selected={page.dienst === 'Timmerwerken en dakkapellen'}>Timmerwerken / dakkapel</option>
            <option value="Zonnepanelen">Zonnepanelen</option>
            <option value="Ecopanelen">Ecopanelen</option>
            <option value="Daklek / herstelling" selected={page.dienst === 'Daklek / herstelling'}>Daklek / herstelling</option>
            <option value="Totaalrenovatie">Totaalrenovatie</option>
            <option value="Weet ik nog niet" selected={page.dienst === 'Weet ik nog niet'}>Weet ik nog niet</option>
          </select>
        </label>
        <label class="field">
          <span>Wanneer wilt u starten?</span>
          <select name="timing">
            <option value="">Kies een periode…</option>
            <option>Zo snel mogelijk</option>
            <option>Binnen 3 maanden</option>
            <option>Later dit jaar</option>
            <option>Ik oriënteer me nog</option>
          </select>
        </label>
        <label class="field">
          <span>Uw project (optioneel)</span>
          <textarea name="bericht" rows="5" placeholder="Bv. rijwoning, oude pannen, zolder niet geïsoleerd…"></textarea>
        </label>
        <input type="text" name="website" class="cform__honeypot" tabindex="-1" autocomplete="off" aria-hidden="true">
        <input type="hidden" name="source_block" value={`Landingspagina /${page.slug}`}>
        <input type="hidden" name="premie_summary">
        <label class="check">
          <input type="checkbox" name="akkoord" required>
          <span>Ik ga akkoord dat INGBELG mijn gegevens gebruikt om over deze aanvraag contact met mij op te nemen. Lees ons <a href="/privacybeleid">privacybeleid</a>.</span>
        </label>
        <button class="btn btn--primary btn--lg btn--block" type="submit">
          <span>Plaatsbezoek aanvragen</span>
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h13M13 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>
        <p class="cform__note">Gratis en vrijblijvend &middot; we bellen u binnen {facts.callbackWorkdays} werkdag terug voor een afspraak</p>
        <p class="cform__msg" id="formMsg" role="status"></p>
      </form>
    </div>
  </div>
</section>

</main>

{/* ============ FOOTER ============ */}

---
/* Startpagina — OVER ONS (C-24, verplaatst na de calculator) */
import { getCollection } from 'astro:content';
import facts from '../../data/site-facts.json';

const services = (await getCollection('services')).sort((a, b) => a.data.num.localeCompare(b.data.num));
---
<section class="about section" id="over">
  <div class="container about__grid">
    <div class="about__media reveal">
      <div class="about__img about__img--main">
        <img src="/assets/work/work-05.webp" alt="Dakwerken door INGBELG" width="1600" height="1200" loading="lazy">
      </div>
      <div class="about__img about__img--sub">
        <img src="/assets/services/platte-daken.webp" alt="Plat dak met EPDM" width="1024" height="806" loading="lazy">
      </div>
    </div>

    <div class="about__body reveal">
      <p class="eyebrow"><span class="eyebrow__bar"></span>Over INGBELG</p>
      <h2 class="h2">Een dakwerker uit Zottegem, met de <em>zaakvoerder</em> zelf op de werf</h2>
      <p class="lead">
        INGBELG is een dak- en renovatiebedrijf uit de {facts.address.street} in {facts.address.city}.
        Zaakvoerder {facts.owner} bouwde het bedrijf op met een eigen, vaste ploeg van {facts.teamSize} vakmensen:
        dakdekkers en timmerlieden die elk dak zelf leggen, zonder wisselende onderaannemers. U hebt één
        aanspreekpunt, van het eerste plaatsbezoek tot de oplevering.
      </p>

      <p style="font-style:italic;color:var(--slate);margin-bottom:24px">&ldquo;Zaakvoerder {facts.owner} is iemand die zijn woord houdt&rdquo; — Jorun &amp; Yves, Google</p>

      <ul class="ticks">
        <li>Vast aanspreekpunt tijdens het hele project</li>
        <li>Eigen, ervaren dakdekkers en timmerlieden</li>
        <li>Duidelijke prijsafspraken en een strikte planning</li>
        <li>Advies over premies en btw inbegrepen</li>
      </ul>

      <div class="about__cta">
        <a class="btn btn--primary" href="#contact"><span>Vraag een gratis plaatsbezoek</span></a>
        <a class="btn btn--line" href={`tel:${facts.phoneE164}`}>
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6.6 10.8a15.1 15.1 0 0 0 6.6 6.6l2.2-2.2a1 1 0 0 1 1-.25c1.1.37 2.3.57 3.6.57a1 1 0 0 1 1 1V20a1 1 0 0 1-1 1A17 17 0 0 1 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1c0 1.3.2 2.5.57 3.6a1 1 0 0 1-.25 1z"/></svg>
          <span>{facts.phone}</span>
        </a>
      </div>
    </div>
  </div>
</section>

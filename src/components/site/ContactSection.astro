---
/* Contactblok met het offerteformulier (#offerteForm → public/js/main.js → /api/contact → e-mail + Odoo).
   Eén formulier voor alle pagina's; de keuzelijst komt uit src/data/navigation.ts. */
import facts from '../../data/site-facts.json';
import { FORM_SERVICES, type ServiceValue } from '../../data/navigation';

interface Props {
  dienst?: ServiceValue;   // vooraf gekozen dienst (dienstpagina)
  sourceBlock?: string;    // herkomst voor de lead, bv. "Landingspagina /hellend-dak"
}
const { dienst, sourceBlock } = Astro.props;
import Icon from './Icon.astro';
---
<section class="section contact" id="contact">
  <div class="container">
    <header class="sechead sechead--center reveal">
      <p class="eyebrow eyebrow--center"><span class="eyebrow__bar"></span>Contact</p>
      <h2 class="h2">Vraag uw <em>gratis plaatsbezoek</em> aan</h2>
      <p class="sechead__sub">Vul het formulier in, bel of stuur een WhatsApp. We bellen u binnen {facts.callbackWorkdays} werkdag terug om een moment af te spreken.</p>
    </header>

    <div class="contact__grid">
      <div class="contact__info">
        <a class="cinfo reveal" href={`tel:${facts.phoneE164}`}>
          <span class="cinfo__ico"><Icon name="phone" decorative={false} /></span>
          <span class="cinfo__txt"><strong>Telefoon</strong><em>{facts.phone}</em></span>
        </a>
        <a class="cinfo reveal" href={`https://wa.me/${facts.phoneE164.replace('+', '')}`} target="_blank" rel="noopener">
          <span class="cinfo__ico"><Icon name="whatsapp" decorative={false} /></span>
          <span class="cinfo__txt"><strong>WhatsApp</strong><em>{facts.phone}</em></span>
        </a>
        <a class="cinfo reveal" href={`mailto:${facts.email}`}>
          <span class="cinfo__ico"><Icon name="mail" decorative={false} /></span>
          <span class="cinfo__txt"><strong>E-mail</strong><em>{facts.email}</em></span>
        </a>
        <a class="cinfo reveal" href="https://maps.google.com/?q=Hoogstraat+59+Zottegem" target="_blank" rel="noopener">
          <span class="cinfo__ico"><Icon name="pin" decorative={false} /></span>
          <span class="cinfo__txt"><strong>Adres</strong><em>{facts.address.street}, {facts.address.postalCode} {facts.address.city}</em></span>
        </a>
        <div class="cinfo cinfo--static reveal">
          <span class="cinfo__ico"><Icon name="clock" decorative={false} /></span>
          <span class="cinfo__txt">
            <strong>Openingsuren</strong>
            {facts.openingHours.map((slot) => <em>{slot.label}: {slot.opens} – {slot.closes}</em>)}
            {facts.closedDays.map((day) => <em>{day}: gesloten</em>)}
          </span>
        </div>
      </div>

      <form class="cform reveal" id="offerteForm" novalidate>
        <div class="cform__row">
          <label class="field">
            <span>Naam <i>*</i></span>
            <input type="text" name="naam" required placeholder="Uw voor- en achternaam">
          </label>
          <label class="field">
            <span>Telefoon <i>*</i></span>
            <input type="tel" name="telefoon" required placeholder="+32 4.. .. .. ..">
          </label>
        </div>
        <div class="cform__row">
          <label class="field">
            <span>E-mail <i>*</i></span>
            <input type="email" name="email" required placeholder="naam@voorbeeld.be">
          </label>
          <label class="field">
            <span>Gemeente <i>*</i></span>
            <input type="text" name="gemeente" required placeholder="Bv. Zottegem">
          </label>
        </div>
        <label class="field">
          <span>Wat moet er gebeuren? <i>*</i></span>
          <select name="dienst" required>
            <option value="">Kies een dienst…</option>
            {FORM_SERVICES.map((o) => <option value={o.value} selected={o.value === dienst}>{o.label}</option>)}
          </select>
        </label>
        <label class="field">
          <span>Wanneer wilt u starten?</span>
          <select name="timing">
            <option value="">Kies een periode…</option>
            <option>Zo snel mogelijk</option>
            <option>Binnen 3 maanden</option>
            <option>Later dit jaar</option>
            <option>Ik oriënteer me nog</option>
          </select>
        </label>
        <label class="field">
          <span>Uw project (optioneel)</span>
          <textarea name="bericht" rows="5" placeholder="Bv. rijwoning, oude pannen, zolder niet geïsoleerd…"></textarea>
        </label>
        <input type="text" name="website" class="cform__honeypot" tabindex="-1" autocomplete="off" aria-hidden="true">
        <input type="hidden" name="source_block" value={sourceBlock}>
        <input type="hidden" name="premie_summary">
        <label class="check">
          <input type="checkbox" name="akkoord" required>
          <span>Ik ga akkoord dat INGBELG mijn gegevens gebruikt om over deze aanvraag contact met mij op te nemen. Lees ons <a href="/privacybeleid">privacybeleid</a>.</span>
        </label>
        <button class="btn btn--primary btn--lg btn--block" type="submit">
          <span>Plaatsbezoek aanvragen</span>
          <Icon name="arrow" />
        </button>
        <p class="cform__note">Gratis en vrijblijvend &middot; we bellen u binnen {facts.callbackWorkdays} werkdag terug voor een afspraak</p>
        <p class="cform__msg" id="formMsg" role="status"></p>
      </form>
    </div>
  </div>
</section>

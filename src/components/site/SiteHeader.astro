---
/* Kopbalk: logo + bel-knop + "Gratis plaatsbezoek". Het menu (alleen op de startpagina) komt via de slot,
   zodat de kopbalk zelf niet hoeft te veranderen als een pagina een eigen menu wil. */
import facts from '../../data/site-facts.json';

interface Props {
  brandHref: string;
  brandLabel: string;
  burger?: boolean; // hamburgerknop voor het mobiele menu (enkel samen met een menu in de slot)
}
const { brandHref, brandLabel, burger = false } = Astro.props;
---
<header class="header" id="header">
  <div class="container header__in">
    <a class="brand" href={brandHref} aria-label={brandLabel}>
      <img src="/assets/logo-transparent.png" alt="INGBELG — algemene dakwerken en renovatie" width="430" height="207">
    </a>
    <slot />
    <div class="header__actions">
      <a class="btn btn--line btn--icon" href={`tel:${facts.phoneE164}`} aria-label={`Bel ${facts.phone}`} title={facts.phone}>
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6.6 10.8a15.1 15.1 0 0 0 6.6 6.6l2.2-2.2a1 1 0 0 1 1-.25c1.1.37 2.3.57 3.6.57a1 1 0 0 1 1 1V20a1 1 0 0 1-1 1A17 17 0 0 1 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1c0 1.3.2 2.5.57 3.6a1 1 0 0 1-.25 1z"/></svg>
      </a>
      <a class="btn btn--primary" href="#contact">
        <span>Gratis plaatsbezoek</span>
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h13M13 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </a>
      {burger && (
        <button class="burger" id="burger" aria-label="Menu openen" aria-expanded="false" aria-controls="nav">
          <span></span><span></span><span></span>
        </button>
      )}
    </div>
  </div>
</header>

# Kopieer naar .env en vul in vóór livegang.
# Zonder deze variabelen logt /api/contact de aanvraag alleen naar de console
# i.p.v. ze te versturen — handig voor de demo, niet voor productie.

# API-key van https://resend.com (of vervang de provider in src/pages/api/contact.ts)
RESEND_API_KEY=

# E-mailadres dat offerteaanvragen ontvangt (standaard: info@ingbelg.be)
CONTACT_NOTIFY_EMAIL=info@ingbelg.be

# GA4 Measurement ID (bv. G-XXXXXXXXXX). Zonder deze variabele laadt Google Analytics
# gewoon niet — de site werkt verder normaal (T-01).
PUBLIC_GA_ID=

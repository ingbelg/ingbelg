# Kopieer naar .env en vul in vóór livegang.
# Zonder deze variabelen logt /api/contact de aanvraag alleen naar de console
# i.p.v. ze te versturen — handig voor de demo, niet voor productie.

# API-key van https://resend.com (of vervang de provider in src/pages/api/contact.ts)
RESEND_API_KEY=

# E-mailadres dat offerteaanvragen ontvangt (standaard: info@ingbelg.be)
CONTACT_NOTIFY_EMAIL=info@ingbelg.be

# Afzender van de mails. VERPLICHT voor echte levering: verifieer eerst het domein ingbelg.be in Resend
# (DNS-records bij Combell), en zet dan bv.: INGBELG website <noreply@ingbelg.be>
# Zonder deze variabele gebruikt de code onboarding@resend.dev, dat enkel naar het Resend-account zelf levert.
CONTACT_FROM_EMAIL=

# Odoo CRM: elke aanvraag wordt ook als lead aangemaakt via het websiteformulier van Odoo.
# Leeg = uit. Voor INGBELG: https://ing-belg-bv.odoo.com/website/form/crm.lead
ODOO_LEAD_FORM_URL=

# GA4 Measurement ID (bv. G-XXXXXXXXXX). Zonder deze variabele laadt Google Analytics
# gewoon niet — de site werkt verder normaal (T-01).
PUBLIC_GA_ID=
